---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = 'Personal finance, minus the jargon. Watch your dhan compound.', noindex = false } = Astro.props;
const pathname = Astro.url.pathname;
const isJourney = pathname.startsWith('/posts');
const isPortfolio = pathname === '/portfolio' || pathname === '/portfolio/';
const isAnalyze = pathname.startsWith('/portfolio/analyze');
const isReports = pathname.startsWith('/portfolio/reports');
const isCapitalFlows = pathname.startsWith('/capital-flows');
const isOwnership = pathname.startsWith('/ownership');
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('cd-theme') === 'light' ? 'light' : 'dark';
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=Hanken+Grotesk:wght@400..700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="brand" href="/" aria-label="Compounding Dhan home">
          <svg class="logo" viewBox="0 0 38 38" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <!-- sprout -->
            <g class="sprout">
              <path class="leaf-l" d="M19 13 C12 12 9 7 10 4 C15 4 18 8 19 13Z" fill="#16A34A"/>
              <path class="leaf-r" d="M19 13 C26 12 29 7 28 4 C23 4 20 8 19 13Z" fill="#0C7036"/>
              <rect x="18" y="12" width="2" height="6" rx="1" fill="#0C7036"/>
            </g>
            <!-- coin -->
            <g class="coin">
              <circle cx="19" cy="25" r="11" fill="#F59E0B"/>
              <circle cx="19" cy="25" r="11" fill="none" stroke="#C9780A" stroke-width="2"/>
              <text x="19" y="30" text-anchor="middle" font-family="Bricolage Grotesque, sans-serif" font-size="13" font-weight="800" fill="#FFFBF2">₹</text>
            </g>
          </svg>
          <span class="brand-name">Compounding <span class="dhan">Dhan</span></span>
        </a>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href="/posts" class:list={{ active: isJourney }} aria-current={isJourney ? 'page' : undefined}>My Journey</a>
          <div class="nav-group" class:list={{ active: isPortfolio || isAnalyze || isReports }}>
            <a href="/portfolio" aria-current={isPortfolio ? 'page' : undefined}>Portfolio</a>
            <button class="nav-caret" type="button" aria-expanded="false" aria-label="Show Portfolio submenu">▾</button>
            <div class="nav-submenu">
              <a href="/portfolio/analyze" aria-current={isAnalyze ? 'page' : undefined}>Analyze</a>
              <a href="/portfolio/reports" aria-current={isReports ? 'page' : undefined}>Reports</a>
            </div>
          </div>
          <a href="/capital-flows" class:list={{ active: isCapitalFlows }} aria-current={isCapitalFlows ? 'page' : undefined}>Capital Flows</a>
          <a href="/ownership" class:list={{ active: isOwnership }} aria-current={isOwnership ? 'page' : undefined}>Ownership</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="container">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        © {new Date().getFullYear()} Compounding Dhan · Money grows when you leave it alone <span class="wink">so do we.</span>
      </div>
    </footer>
    <button class="theme-toggle theme-toggle-floating" id="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false"><span aria-hidden="true">☾</span><span class="theme-toggle-label">Dark</span></button>
  </body>
</html>

<script is:inline>
  const storedTheme = localStorage.getItem('cd-theme');
  const theme = storedTheme === 'light' ? 'light' : 'dark';
  document.documentElement.dataset.theme = theme;
  const toggle = document.querySelector('#theme-toggle');
  const updateToggle = (value) => {
    if (!toggle) return;
    const dark = value === 'dark';
    toggle.setAttribute('aria-pressed', String(dark));
    toggle.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    toggle.innerHTML = `<span aria-hidden="true">${dark ? '☀' : '☾'}</span><span class="theme-toggle-label">${dark ? 'Light' : 'Dark'}</span>`;
  };
  updateToggle(theme);
  toggle?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('cd-theme', next);
    updateToggle(next);
  });

  document.querySelectorAll('.nav-caret').forEach((caret) => {
    caret.addEventListener('click', (event) => {
      event.preventDefault();
      const group = caret.closest('.nav-group');
      const isOpen = group.classList.toggle('open');
      caret.setAttribute('aria-expanded', String(isOpen));
    });
  });
  document.addEventListener('click', (event) => {
    document.querySelectorAll('.nav-group.open').forEach((group) => {
      if (group.contains(event.target)) return;
      group.classList.remove('open');
      group.querySelector('.nav-caret')?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
