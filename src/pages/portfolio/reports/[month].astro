---
import Base from '../../../layouts/Base.astro';
export function getStaticPaths() {
  const paths = [];
  for (let year = 2024; year <= 2035; year++) for (let month = 1; month <= 12; month++) paths.push({ params: { month: `${year}-${String(month).padStart(2, '0')}` } });
  return paths;
}
---

<Base title="Monthly portfolio report · Compounding Dhan" description="The important portfolio performance and company developments for the month.">
  <section class="report-page"><p class="back-link"><a href="/portfolio/reports/">← Monthly reports</a></p><div id="report"><p class="muted">Loading report…</p></div></section>
</Base>

<style is:global>
  .report-page { max-width: 62rem; margin: 0 auto; padding: 2.5rem 0 5rem; }
  .back-link { margin: 0 0 1.75rem; font-size: .88rem; } .muted { color: var(--muted); }
  .report-head { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .report-head h1 { margin: .35rem 0 0; font-size: clamp(2rem,5vw,3.5rem); line-height: 1; }
  .report-status { display: inline-flex; padding: .25rem .65rem; border-radius: 999px; background: var(--mint); color: var(--leaf-deep); font-size: .7rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .report-period { color: var(--muted); font-size: .85rem; white-space: nowrap; }
  .scoreboard { display: grid; grid-template-columns: 1.35fr repeat(3,1fr); overflow: hidden; border: 2px solid var(--line); border-radius: 18px; background: var(--paper); box-shadow: 0 10px 30px rgba(31,53,43,.06); }
  .score { padding: 1.2rem 1.15rem; border-left: 1px solid var(--line); } .score:first-child { border-left: 0; background: var(--mint); }
  .score span { display: block; margin-bottom: .3rem; color: var(--muted); font-size: .7rem; font-weight: 700; text-transform: uppercase; }
  .score strong { font: 800 clamp(1.35rem,3vw,2rem) var(--font-display); } .positive { color: var(--leaf-deep); } .negative { color: var(--coral); }
  .alpha-visual { margin: .8rem 0 2.5rem; } .alpha-track { position: relative; height: 1.2rem; background: linear-gradient(90deg,#fff0f0 0 50%,var(--mint) 50% 100%); border-radius: 999px; }
  .alpha-zero { position: absolute; left: 50%; inset-block: 0; width: 2px; background: var(--paper); }
  .alpha-dot { position: absolute; width: .72rem; height: .72rem; border: 2px solid var(--paper); border-radius: 50%; transform: translate(-50%,-50%); box-shadow: 0 1px 4px rgba(0,0,0,.22); z-index: 2; }
  .benchmark-nifty50 { background:#7b1fa2; } .benchmark-midcap { background:#ed8b00; } .benchmark-smallcap { background:#00897b; }
  .alpha-legend { display:flex; flex-wrap:wrap; gap:.5rem 1rem; margin-bottom:.5rem; color:var(--muted); font-size:.72rem; }
  .alpha-legend span { display:inline-flex; align-items:center; gap:.3rem; } .legend-swatch { width:.55rem; height:.55rem; border-radius:50%; }
  .section-title { margin: 2.5rem 0 1rem; font-size: 1.25rem; }
  .portfolio-brief { padding:1.25rem 1.35rem; border-radius:16px; background:#f5f0ff; border:1px solid #dfd2f2; }
  .portfolio-brief p { margin:.35rem 0 0; line-height:1.55; }
  .risk-pill { display:inline-flex; padding:.2rem .55rem; border-radius:999px; background:var(--paper); color:var(--muted); font-size:.68rem; font-weight:800; text-transform:uppercase; }
  .action-list { display:grid; gap:.65rem; margin:.85rem 0 0; padding:0; list-style:none; }
  .action-list li { display:grid; grid-template-columns:5rem 1fr; gap:.8rem; padding:.85rem 1rem; border:1px solid var(--line); border-radius:12px; background:var(--paper); }
  .action-priority { color:var(--coral); font-size:.7rem; font-weight:800; text-transform:uppercase; }
  .action-copy strong { display:block; margin-bottom:.2rem; } .action-copy p { margin:0; color:var(--muted); font-size:.84rem; }
  .action-trigger { display:block; margin-top:.3rem; color:var(--ink); font-size:.76rem; }
  .committee-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(16rem,1fr)); gap:.75rem; }
  .committee-card { padding:1rem 1.05rem; border:1px solid var(--line); border-radius:14px; background:var(--paper); }
  .committee-card-head { display:flex; align-items:start; justify-content:space-between; gap:.75rem; margin-bottom:.65rem; }
  .thesis-status { padding:.2rem .5rem; border-radius:999px; background:var(--paper-2); color:var(--muted); font-size:.65rem; font-weight:800; text-transform:uppercase; }
  .thesis-status.strengthened { background:var(--mint); color:var(--leaf-deep); }
  .thesis-status.weakened,.thesis-status.broken { background:#fff0f0; color:var(--coral); }
  .committee-card p { margin:.4rem 0; font-size:.84rem; line-height:1.5; }
  .committee-card small { color:var(--muted); }
  .committee-dissent { padding-top:.45rem; border-top:1px solid var(--line); color:var(--muted); }
  .committee-meta { margin:.8rem 0 0; color:var(--muted); font-size:.72rem; }
  .holding-strip { display:grid; grid-template-columns:repeat(auto-fit,minmax(9rem,1fr)); gap:.65rem; }
  .holding-chip { padding:.85rem 1rem; border:1px solid var(--line); border-radius:12px; background:var(--paper); }
  .holding-chip strong { display:block; font-size:.85rem; } .holding-chip span { font:800 1.2rem var(--font-display); } .holding-chip small { display:block; color:var(--muted); }
  .street-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(13rem,1fr)); gap:.65rem; }
  .street-card { padding:1rem; border:1px solid var(--line); border-radius:12px; background:var(--paper); }
  .street-card-head { display:flex; justify-content:space-between; gap:.5rem; margin-bottom:.6rem; }
  .street-rating { color:var(--leaf-deep); font-size:.72rem; font-weight:800; text-transform:capitalize; }
  .street-target { font:800 1.3rem var(--font-display); } .street-card small { display:block; color:var(--muted); line-height:1.45; }
  .highlight-grid { display:grid; gap:.9rem; }
  .highlight-card { position:relative; padding:1.2rem 1.3rem 1.15rem 1.5rem; border:1px solid var(--line); border-radius:16px; background:var(--paper); box-shadow:0 8px 24px rgba(31,53,43,.05); }
  .highlight-card::before { content:''; position:absolute; inset:0 auto 0 0; width:5px; border-radius:16px 0 0 16px; background:var(--marigold); }
  .highlight-card.severity-high::before { background:var(--coral); }
  .highlight-card.severity-medium::before { background:var(--coral); }
  .highlight-card.severity-low::before { background:var(--marigold); }
  .highlight-meta { display:flex; justify-content:space-between; gap:1rem; margin-bottom:.55rem; } .highlight-meta strong { font-size:1rem; }
  .severity-label { color:var(--muted); font-size:.72rem; font-weight:800; text-transform:uppercase; }
  .highlight-card p { margin:0; line-height:1.55; } .highlight-source { display:flex; gap:.8rem; margin-top:.75rem; color:var(--muted); font-size:.76rem; }
  .priority-list { display:grid; gap:.55rem; margin:0; padding:0; list-style:none; } .priority-list li { padding:.75rem .9rem; border-radius:10px; background:#fff8e8; } .priority-list .severity-high { background:#fff0f0; }
  .coverage-details { margin-top:2.5rem; padding-top:1rem; border-top:1px solid var(--line); color:var(--muted); font-size:.8rem; }
  .coverage-details summary { cursor:pointer; font-weight:700; } .disclaimer { margin-top:1.5rem; color:var(--muted); font-size:.75rem; }
  @media (max-width:720px) { .scoreboard { grid-template-columns:1fr 1fr; } .score:nth-child(3) { border-left:0; border-top:1px solid var(--line); } .score:nth-child(4) { border-top:1px solid var(--line); } .report-head { align-items:start; flex-direction:column; } }
</style>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  const month = location.pathname.split('/').filter(Boolean).at(-1)!;
  const token = localStorage.getItem('portfolioAdminToken');
  const headers: Record<string,string> = token ? { Authorization:`Bearer ${token}` } : {};
  const target = document.querySelector<HTMLElement>('#report')!;
  const escapeHtml = (value:unknown) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'})[char]!);
  const pct = (value:number|null) => value == null ? 'N/A' : `${value >= 0 ? '+' : ''}${value.toFixed(2)}%`;
  const pctClass = (value:number|null) => value == null ? '' : value >= 0 ? 'positive' : 'negative';
  const severityRank:Record<string,number> = { high:4, medium:3, low:2, none:1 };
  const ALPHA_SERIES = [{key:'alphaVsNifty50Pct',label:'Nifty 50',className:'benchmark-nifty50'},{key:'alphaVsNiftyMidcapPct',label:'Midcap 50',className:'benchmark-midcap'},{key:'alphaVsNiftySmallcapPct',label:'Smallcap 250',className:'benchmark-smallcap'}];
  const alphaOverlay = (values:any) => {
    const available = ALPHA_SERIES.filter((series) => values[series.key] != null); if (!available.length) return '';
    const maxAbs = Math.max(...available.map((series) => Math.abs(values[series.key])),1);
    const dots = available.map((series,index) => `<span class="alpha-dot ${series.className}" style="left:${50+(values[series.key]/maxAbs)*48}%;top:${30+index*20}%" title="${series.label}: ${pct(values[series.key])}"></span>`).join('');
    return `<div class="alpha-visual"><div class="alpha-legend">${available.map((series) => `<span><i class="legend-swatch ${series.className}"></i>${series.label}</span>`).join('')}</div><div class="alpha-track"><div class="alpha-zero"></div>${dots}</div></div>`;
  };
  const importantAiHighlights = (holdings:any[]) => holdings.flatMap((holding) => {
    const reviews = [...(holding.governance?.aiReviews || [])].filter((review) => review.summary).sort((a,b) => (severityRank[b.severity]||0)-(severityRank[a.severity]||0) || String(b.occurred_at).localeCompare(String(a.occurred_at)));
    return reviews.length ? [{symbol:holding.symbol,...reviews[0]}] : [];
  }).sort((a,b) => (severityRank[b.severity]||0)-(severityRank[a.severity]||0));

  function committeeHtml(committee:any) {
    if (!committee) return '';
    const debateBySymbol=new Map((committee.debates || []).map((debate:any) => [debate.symbol,debate]));
    const cards=(committee.verdicts || []).map((verdict:any) => { const valuation:any=debateBySymbol.get(verdict.symbol)?.valuation; return `<article class="committee-card"><div class="committee-card-head"><strong>${escapeHtml(verdict.symbol)}</strong><span class="thesis-status ${escapeHtml(verdict.thesisStatus)}">${escapeHtml(String(verdict.thesisStatus).replaceAll('-',' '))}</span></div><p>${escapeHtml(verdict.winningArgument)}</p>${valuation ? `<p><small>Valuation specialist · ${escapeHtml(valuation.assessment)}</small><br>${escapeHtml(valuation.summary)}</p>` : ''}${verdict.strongestDissent ? `<p class="committee-dissent"><small>Strongest dissent</small><br>${escapeHtml(verdict.strongestDissent)}</p>` : ''}<p><small>Committee action</small><br>${escapeHtml(String(verdict.action).replaceAll('-',' '))}</p><p><small>Next observable trigger</small><br>${escapeHtml(verdict.trigger)}</p>${verdict.thesisEvolution && verdict.thesisEvolution !== 'none' ? `<p><small>Proposed thesis ${escapeHtml(verdict.thesisEvolution)} · requires your approval</small><br>${escapeHtml(verdict.evolutionProposal)}${verdict.evolutionRationale ? ` — ${escapeHtml(verdict.evolutionRationale)}` : ''}</p>` : ''}</article>`; }).join('');
    return `<h2 class="section-title">Investment committee</h2><div class="committee-grid">${cards}</div><p class="committee-meta">Bounded Bull/Bear debate · philosophy and portfolio-risk review · human approval required for every trade · ${escapeHtml(committee.promptVersion || '')}</p>`;
  }

  function render(data:any) {
    const report=data.report, warnings=report.dataQuality?.warnings || [], highlights=importantAiHighlights(report.holdings || []);
    const highlightedSymbols=new Set(highlights.map((item) => item.symbol));
    const priorities=(report.reviewPoints || []).filter((point:any) => !(highlightedSymbols.has(point.symbol) && /governance keyword/i.test(point.reason))).slice(0,3);
    const street=(report.holdings || []).filter((holding:any) => (holding.fundamentals?.current?.recommendation && holding.fundamentals.current.recommendation !== 'none') || holding.fundamentals?.current?.targetMeanPrice != null);
    target.innerHTML=`
      <header class="report-head"><div><span class="report-status">${escapeHtml(data.status)}</span><h1>${escapeHtml(report.reportMonth)}</h1></div><span class="report-period">Monthly portfolio review</span></header>
      <div class="scoreboard"><div class="score"><span>Portfolio return</span><strong class="${pctClass(report.portfolio.returnPct)}">${pct(report.portfolio.returnPct)}</strong></div><div class="score"><span>vs Nifty 50</span><strong class="${pctClass(report.portfolio.alphaVsNifty50Pct)}">${pct(report.portfolio.alphaVsNifty50Pct)}</strong></div><div class="score"><span>vs Midcap 50</span><strong class="${pctClass(report.portfolio.alphaVsNiftyMidcapPct)}">${pct(report.portfolio.alphaVsNiftyMidcapPct)}</strong></div><div class="score"><span>vs Smallcap 250</span><strong class="${pctClass(report.portfolio.alphaVsNiftySmallcapPct)}">${pct(report.portfolio.alphaVsNiftySmallcapPct)}</strong></div></div>
      ${alphaOverlay(report.portfolio)}
      ${report.portfolioAnalysis ? `<section class="portfolio-brief"><span class="risk-pill">${escapeHtml(report.portfolioAnalysis.riskLevel)} portfolio risk</span><p>${escapeHtml(report.portfolioAnalysis.summary)}</p></section>${report.portfolioAnalysis.actions?.length ? `<h2 class="section-title">Action list</h2><ul class="action-list">${report.portfolioAnalysis.actions.map((item:any) => `<li><span class="action-priority">${escapeHtml(item.priority)}</span><div class="action-copy"><strong>${escapeHtml(item.symbol)} · ${escapeHtml(item.action)}</strong><p>${escapeHtml(item.rationale)}</p><span class="action-trigger">Trigger: ${escapeHtml(item.trigger)}</span></div></li>`).join('')}</ul>` : ''}` : ''}
      ${committeeHtml(report.investmentCommittee)}
      <h2 class="section-title">Holdings this month</h2><div class="holding-strip">${report.holdings.map((holding:any) => `<div class="holding-chip"><strong>${escapeHtml(holding.symbol)}</strong><span class="${pctClass(holding.performance.returnPct)}">${pct(holding.performance.returnPct)}</span><small>${pct(holding.performance.alphaVsNifty50Pct)} vs Nifty 50</small></div>`).join('')}</div>
      ${street.length ? `<h2 class="section-title">Street view</h2><div class="street-grid">${street.map((holding:any) => { const current=holding.fundamentals.current; const target=current.targetMeanPrice; const price=holding.technical.monthEndPrice; const implied=target != null && price ? ((target-price)/price)*100 : null; const rating=current.recommendation && current.recommendation !== 'none' ? current.recommendation : 'target available'; return `<div class="street-card"><div class="street-card-head"><strong>${escapeHtml(holding.symbol)}</strong><span class="street-rating">${escapeHtml(String(rating).replaceAll('_',' '))}</span></div><div class="street-target">${target == null ? 'No target' : `₹${Number(target).toFixed(2)}`}</div><small>${implied == null ? '' : `${pct(implied)} implied from month-end · `}${current.targetLowPrice != null && current.targetHighPrice != null ? `range ₹${Number(current.targetLowPrice).toFixed(0)}–₹${Number(current.targetHighPrice).toFixed(0)} · ` : ''}External consensus as of ${escapeHtml(holding.fundamentals.currentAsOf || 'latest fetch')}</small></div>`; }).join('')}</div>` : ''}
      <h2 class="section-title">What mattered</h2>
      ${highlights.length ? `<div class="highlight-grid">${highlights.map((item:any) => `<article class="highlight-card severity-${escapeHtml(item.severity)}"><div class="highlight-meta"><strong>${escapeHtml(item.symbol)}</strong><span class="severity-label">${escapeHtml(item.severity)} priority</span></div><p>${escapeHtml(item.summary)}</p><div class="highlight-source"><span>${Math.round((Number(item.confidence)||0)*100)}% confidence</span>${item.url ? `<a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer">Source filing →</a>` : ''}</div></article>`).join('')}</div>` : '<p class="muted">No material filing development was identified for this month.</p>'}
      ${priorities.length ? `<h2 class="section-title">Also worth watching</h2><ul class="priority-list">${priorities.map((point:any) => `<li class="severity-${escapeHtml(point.severity)}"><strong>${escapeHtml(point.symbol)}</strong> · ${escapeHtml(point.reason)}</li>`).join('')}</ul>` : ''}
      ${warnings.length ? `<details class="coverage-details"><summary>Data coverage notes (${warnings.length})</summary><ul>${warnings.map((warning:string) => `<li>${escapeHtml(warning)}</li>`).join('')}</ul></details>` : ''}<p class="disclaimer">${escapeHtml(report.disclaimer)}</p>`;
  }
  fetch(`${API_URL}/api/portfolio/reports/${encodeURIComponent(month)}`,{headers}).then(async(res)=>{const data=await res.json();if(!res.ok)throw new Error(data.error||`HTTP ${res.status}`);return data;}).then(render).catch((error)=>{target.innerHTML=`<h1>Report unavailable</h1><p class="muted">${escapeHtml(error.message)}</p>`;});
</script>
