---
import Base from '../../../layouts/Base.astro';
---

<Base title="Monthly portfolio reports · Compounding Dhan" description="Monthly portfolio performance, developments, governance review and evidence.">
  <section class="reports-page">
    <p class="hint"><a href="/portfolio/">← Back to portfolio</a></p>
    <h1>Monthly portfolio reports</h1>
    <p class="intro">A monthly record of portfolio performance, thesis changes and the evidence behind each decision.</p>
    <div id="reports"><p class="hint">Loading reports…</p></div>
    <p class="disclaimer">Automated research aid, not investment advice. Every trade requires human approval.</p>
  </section>
</Base>

<style>
  .reports-page { max-width: 52rem; padding: 2rem 0 4rem; }
  .hint { color: var(--muted); }
  .intro { max-width: 42rem; color: var(--muted); font-size: 1.05rem; line-height: 1.65; }
  .report-list { display: grid; gap: 0.85rem; margin-top: 1.75rem; }
  .report-link { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.4rem 1rem; padding: 1.15rem 1.25rem; border: 1px solid var(--line); border-radius: var(--radius); background: var(--paper); color: inherit; text-decoration: none; transition: border-color 140ms ease, transform 140ms ease; }
  .report-link:hover { border-color: var(--leaf); transform: translateY(-1px); }
  .report-month { font-size: 1.05rem; }
  .report-date { color: var(--muted); font-size: 0.82rem; }
  .status { grid-row: 1 / span 2; grid-column: 2; padding: 0.25rem 0.55rem; border-radius: 999px; background: color-mix(in srgb, var(--leaf) 12%, transparent); color: var(--leaf); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .drafts { margin-top: 2rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  .drafts summary { cursor: pointer; color: var(--muted); font-size: 0.9rem; }
  .drafts .report-list { margin-top: 1rem; }
  .drafts .status { background: color-mix(in srgb, var(--muted) 12%, transparent); color: var(--muted); }
  .disclaimer { margin-top: 2.5rem; color: var(--muted); font-size: 0.8rem; }
</style>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  const token = localStorage.getItem('portfolioAdminToken');
  const headers: Record<string, string> = token ? { Authorization: `Bearer ${token}` } : {};
  const target = document.querySelector<HTMLElement>('#reports')!;
  fetch(`${API_URL}/api/portfolio/reports`, { headers })
    .then(async (res) => {
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    })
    .then((data) => {
      const reports = data.reports || [];
      const published = reports.filter((report: any) => report.status === 'published');
      const drafts = reports.filter((report: any) => report.status !== 'published');
      const monthLabel = (month: string) => {
        const [year, monthNumber] = month.split('-').map(Number);
        return new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(year, monthNumber - 1, 1)));
      };
      const dateLabel = (value?: string) => value
        ? `Published ${new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(value))}`
        : 'Not published';
      const cards = (items: any[]) => `<div class="report-list">${items.map((report: any) => `
        <a class="report-link" href="/portfolio/reports/${report.report_month}/">
          <strong class="report-month">${monthLabel(report.report_month)}</strong>
          <span class="report-date">${dateLabel(report.published_at)}</span>
          <span class="status">${report.status}</span>
        </a>`).join('')}</div>`;
      target.innerHTML = published.length
        ? `${cards(published)}${drafts.length ? `<details class="drafts"><summary>${drafts.length} unpublished draft${drafts.length === 1 ? '' : 's'} · admin only</summary>${cards(drafts)}</details>` : ''}`
        : `${token && drafts.length ? `<p class="hint">No published reports yet.</p><details class="drafts"><summary>${drafts.length} unpublished draft${drafts.length === 1 ? '' : 's'} · admin only</summary>${cards(drafts)}</details>` : '<p class="hint">No reports have been published yet.</p>'}`;
    })
    .catch(() => { target.innerHTML = '<p class="hint">Reports could not be loaded.</p>'; });
</script>
