---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

// Build-time join: any blog post tagged with a `ticker` links onto its matching
// holding card client-side. No Worker/D1 involvement, a newly tagged post
// links automatically on the next site build.
const posts = await getCollection('blog');
const thesisBySymbol: Record<string, { title: string; href: string }> = {};
for (const post of posts) {
  if (post.data.ticker) {
    thesisBySymbol[post.data.ticker] = { title: post.data.title, href: `/blog/${post.id}/` };
  }
}
---

<Base title="Portfolio · Compounding Dhan" description="Live returns and benchmarks. No amounts shown, just the journey.">
  <section class="portfolio">
    <h1>Portfolio</h1>
    <p class="hint">A 12 to 18 month experiment to see how much this can actually generate.</p>
    <p class="hint">Real holdings, real returns. Position sizes stay private: everything here is a percentage.</p>

    <p class="hint">The badges below show position size, not performance: every new stock starts as a small Starter and only grows to Standard or High-conviction once its thesis is actually confirmed. Building toward ~15 positions over that same 12-18 months, not all at once.</p>

    <section class="since-inception" aria-labelledby="since-inception-heading">
      <h2 id="since-inception-heading">Since inception</h2>
      <div id="kpis">
        <p class="loading">Loading overall returns…</p>
      </div>
    </section>

    <h2>Holdings</h2>
    <div class="tier-legend">
      <span class="legend-item"><span class="legend-dot tier-dot-starter"></span>Starter</span>
      <span class="legend-item"><span class="legend-dot tier-dot-standard"></span>Standard</span>
      <span class="legend-item"><span class="legend-dot tier-dot-high-conviction"></span>High-conviction</span>
    </div>

    <section class="performance-section" aria-label="Holding movement period">
      <p class="performance-intro"><strong>Movement period</strong> — choose the dates shown on every holding.</p>
      <div class="performance-presets" role="group" aria-label="Performance period">
        <button type="button" class="performance-preset active" data-range="since-purchase">Since purchase</button>
        <button type="button" class="performance-preset" data-range="1d">1D</button>
        <button type="button" class="performance-preset" data-range="1w">1W</button>
        <button type="button" class="performance-preset" data-range="1m">1M</button>
        <button type="button" class="performance-preset" data-range="3m">3M</button>
        <button type="button" class="performance-preset" data-range="ytd">YTD</button>
      </div>
      <form id="performance-form" class="performance-form" hidden>
        <label>From <input id="performance-from" type="date" required /></label>
        <label>To <input id="performance-to" type="date" required /></label>
        <button type="submit">Calculate</button>
      </form>
      <div id="performance-result" aria-live="polite">
        <p class="performance-range">Each holding is measured from its own purchase history.</p>
      </div>
    </section>
    <div id="holdings" class="holdings-grid">
      <p class="loading">Loading holdings…</p>
    </div>

    <div id="allocation"></div>

    <h2>Analyze</h2>
    <p class="hint">For each holding: did it touch an all-time high this month (and if not, how far off and how long ago), is profit at a recent high, and is it beating Nifty 500 and its sector.</p>
    <a href="/portfolio/analyze/" class="analyze-btn">Analyze portfolio →</a>

    <h2 class="reports-heading">Monthly reports</h2>
    <p class="hint">Portfolio performance, important developments, governance review points and linked evidence for each calendar month.</p>
    <a href="/portfolio/reports/" class="analyze-btn">View monthly reports →</a>

    <div id="benchmarks"></div>
  </section>

  <script type="application/json" id="thesis-map" set:html={JSON.stringify(thesisBySymbol)} />
</Base>

<style is:global>
  .portfolio { padding: 2rem 0 4rem; }
  .hint { color: var(--muted); margin-bottom: 1.5rem; }
  .loading { color: var(--muted); }


  /* ---- KPI row ---- */
  .kpi-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 0; }
  .kpi-tile {
    background: var(--mint); border-radius: var(--radius); padding: 1.25rem 1.5rem;
    flex: 1 1 12rem;
  }
  .kpi-tile.primary { background: linear-gradient(135deg, var(--mint), var(--paper)); border: 2px solid var(--leaf); }
  .kpi-label { font-size: 0.8rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.35rem; }
  .kpi-value { font-size: 2.2rem; font-weight: 800; font-family: var(--font-display); line-height: 1; }
  .kpi-tile.secondary .kpi-value { font-size: 1.6rem; }
  .kpi-value.positive { color: var(--leaf-deep); }
  .kpi-value.negative { color: var(--coral); }
  .kpi-asof { font-size: 0.78rem; color: var(--muted); margin: 0.55rem 0 0; }

  /* ---- Date-range performance ---- */
  .performance-section {
    background: var(--paper-2); border-radius: var(--radius); padding: 1rem 1.1rem; margin: 0 0 1rem;
  }
  .performance-intro { color: var(--muted); font-size: 0.88rem; margin: 0 0 1rem; }
  .performance-presets { display: flex; flex-wrap: wrap; gap: 0.45rem; margin-bottom: 0.9rem; }
  .performance-preset {
    border: 2px solid var(--line); border-radius: 999px; background: var(--paper); color: var(--ink);
    padding: 0.35rem 0.75rem; font: inherit; font-size: 0.78rem; font-weight: 800; cursor: pointer;
  }
  .performance-preset:hover { border-color: var(--leaf); }
  .performance-preset.active { border-color: var(--leaf); background: var(--leaf); color: #fff; }
  .performance-form { display: flex; flex-wrap: wrap; gap: 0.65rem; align-items: end; margin-bottom: 1.15rem; }
  .performance-form[hidden] { display: none; }
  .performance-form label { display: grid; gap: 0.25rem; color: var(--muted); font-size: 0.75rem; font-weight: 700; }
  .performance-form input {
    min-height: 42px; border: 2px solid var(--line); border-radius: 9px; background: var(--paper);
    color: var(--ink); padding: 0.45rem 0.6rem; font: inherit; font-size: 0.85rem;
  }
  .performance-form button {
    min-height: 42px; border: 0; border-radius: 9px; background: var(--ink); color: var(--paper);
    padding: 0.5rem 1rem; font: inherit; font-size: 0.82rem; font-weight: 800; cursor: pointer;
  }
  .performance-form button:disabled { opacity: 0.55; cursor: wait; }
  .performance-range { color: var(--muted); font-size: 0.76rem; margin: 0.45rem 0 0; }
  .performance-warning { background: #fff6e3; color: var(--marigold-deep); border-radius: 8px; padding: 0.55rem 0.7rem; font-size: 0.78rem; margin: 0.65rem 0 0; }
  .performance-error { color: var(--coral); font-weight: 700; font-size: 0.88rem; }
  .since-inception { margin: 1.75rem 0 2.5rem; }
  .since-inception > h2 { margin: 0 0 0.9rem; }
  @media (max-width: 520px) {
    .performance-form label { flex: 1 1 8rem; }
    .performance-form input { width: 100%; }
  }

  /* ---- Since-inception benchmark comparison ---- */
  .benchmarks-block { margin: 2.5rem 0 0; }
  .benchmarks-block h3 { color: var(--muted); font-size: 0.78rem; letter-spacing: 0.05em; margin: 1.1rem 0 0.55rem; text-transform: uppercase; }
  .benchmark-table { border: 2px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .benchmark-row { display: grid; grid-template-columns: minmax(7rem, 1fr) 5rem 6rem; gap: 0.7rem; padding: 0.6rem 0.8rem; align-items: center; font-size: 0.82rem; }
  .benchmark-row + .benchmark-row { border-top: 1px solid var(--line); }
  .benchmark-row.portfolio-row { background: var(--mint); font-weight: 800; }
  .benchmark-name { color: var(--muted); font-weight: 700; }
  .portfolio-row .benchmark-name { color: var(--ink); }
  .benchmark-value, .benchmark-alpha { text-align: right; font-weight: 700; }
  .benchmark-alpha { font-size: 0.76rem; }

  /* ---- Holdings ---- */
  .holdings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 1rem; margin-bottom: 2.5rem; }
  .holding-card {
    background: var(--paper); border: 2px solid var(--line); border-left: 4px solid var(--line);
    border-radius: var(--radius); padding: 1.1rem 1.25rem; cursor: pointer;
    transition: transform 0.15s cubic-bezier(.2,.8,.3,1.4), border-left-color 0.15s, box-shadow 0.15s;
  }
  .holding-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .holding-card.positive { border-left-color: var(--leaf); }
  .holding-card.negative { border-left-color: var(--coral); }
  .holding-symbol { font-weight: 800; font-size: 1.1rem; margin: 0 0 0.5rem; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .tier-badge {
    font-size: 0.65rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.03em;
    padding: 0.15rem 0.5rem; border-radius: 999px; background: var(--paper); color: var(--muted);
    border: 1px solid var(--line);
  }
  .tier-badge.tier-standard { color: var(--marigold-deep); border-color: var(--marigold); }
  .tier-badge.tier-high-conviction { color: var(--leaf-deep); border-color: var(--leaf); }
  .tier-legend { display: flex; gap: 1.1rem; font-size: 0.8rem; color: var(--muted); margin-bottom: 1rem; }
  .legend-item { display: flex; align-items: center; gap: 0.35rem; }
  .legend-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; display: inline-block; border: 2px solid var(--line); }
  .tier-dot-starter { background: var(--paper); border-color: var(--muted); }
  .tier-dot-standard { background: var(--paper); border-color: var(--marigold); }
  .tier-dot-high-conviction { background: var(--paper); border-color: var(--leaf); }
  .holding-thesis { font-size: 0.82rem; margin-bottom: 0.6rem; }
  .holding-card-cta { font-size: 0.78rem; color: var(--muted); margin-top: 0.7rem; font-weight: 600; }
  .holding-thesis a { color: var(--leaf-deep); font-weight: 600; }
  .holding-headline { font-size: 1.6rem; font-weight: 800; font-family: var(--font-display); margin-bottom: 0.6rem; }
  .holding-stats { display: grid; gap: 0.3rem; font-size: 0.85rem; }
  .holding-stats .row { display: flex; justify-content: space-between; gap: 0.5rem; }
  .holding-stats .label { color: var(--muted); }
  .positive { color: var(--leaf-deep); font-weight: 700; }
  .negative { color: var(--coral); font-weight: 700; }

  /* ---- Info tooltip ---- */
  .info-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 0.95rem; height: 0.95rem; border-radius: 50%; flex-shrink: 0;
    background: var(--line); color: var(--muted); font-size: 0.65rem; font-weight: 800;
    cursor: help; position: relative; margin-left: 0.3rem; text-transform: none;
  }
  .info-icon:hover, .info-icon:focus { background: var(--leaf); color: #fff; outline: none; }
  .info-icon .tooltip {
    visibility: hidden; opacity: 0; position: absolute; bottom: 135%; left: 50%; transform: translateX(-50%);
    background: var(--ink); color: var(--paper); padding: 0.55rem 0.75rem; border-radius: 8px;
    font-size: 0.75rem; font-weight: 500; line-height: 1.4; text-align: left;
    width: 15rem; max-width: 60vw; transition: opacity 0.15s; z-index: 20; pointer-events: none;
  }
  .info-icon:hover .tooltip, .info-icon:focus .tooltip { visibility: visible; opacity: 1; }
  .holding-headline-label { display: flex; align-items: center; font-size: 0.8rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.2rem; }
  .label-with-info { display: inline-flex; align-items: center; }

  /* ---- Allocation treemaps ---- */
  .allocation { margin-bottom: 2.5rem; }
  .allocation h2 { font-size: 1.1rem; margin: 0 0 1rem; }
  .alloc-block { margin-bottom: 1.4rem; }
  .alloc-block:last-child { margin-bottom: 0; }
  .alloc-block h3 { font-size: 0.85rem; color: var(--muted); font-weight: 700; margin: 0 0 0.5rem; text-transform: uppercase; letter-spacing: 0.03em; }
  .treemap { display: grid; height: 7rem; border-radius: var(--radius); overflow: hidden; gap: 2px; }
  .treemap-cell {
    display: flex; flex-direction: column; justify-content: flex-end;
    padding: 0.6rem 0.7rem; color: #fff; min-width: 0; overflow: hidden;
  }
  .treemap-name { font-size: 0.78rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .treemap-value { font-size: 1.15rem; font-weight: 800; font-family: var(--font-display); }

  /* ---- Analyze ---- */
  .analyze-btn {
    display: inline-block; background: var(--leaf); color: #fff; border: none; border-radius: 10px;
    padding: 0.65rem 1.4rem; font: inherit; font-weight: 700; cursor: pointer; text-decoration: none;
  }
  .analyze-btn:hover { background: var(--leaf-deep); }
  .reports-heading { margin-top: 2.5rem; }
</style>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';

  const thesisMap: Record<string, { title: string; href: string }> = JSON.parse(
    document.querySelector('#thesis-map')?.textContent || '{}'
  );

  function pctClass(n: number | null): string {
    if (n == null) return '';
    return n >= 0 ? 'positive' : 'negative';
  }

  function fmtPct(n: number | null): string {
    return n == null ? 'N/A' : `${n >= 0 ? '+' : ''}${n.toFixed(2)}%`;
  }

  function fmtPrice(n: number | null): string {
    return n == null ? 'N/A' : `₹${n.toFixed(2)}`;
  }

  const XIRR_INFO =
    'XIRR (annualized return) accounts for the exact date and size of every trade. A short holding period with even a modest gain can annualize to a very large number, that\'s expected, not a bug.';
  const SIMPLE_RETURN_INFO =
    'Absolute return is (current value minus invested) divided by invested, with no adjustment for how long the money was invested. A quick trade and a multi-year hold with the same % gain look identical here.';

  function infoIcon(text: string): string {
    return `<span class="info-icon" tabindex="0">i<span class="tooltip">${text}</span></span>`;
  }

  function renderKpis(summary: any) {
    const el = document.querySelector('#kpis')!;
    el.innerHTML = `
      <div class="kpi-row">
        <div class="kpi-tile primary">
          <div class="kpi-label">Absolute return since purchase${infoIcon(SIMPLE_RETURN_INFO)}</div>
          <div class="kpi-value ${pctClass(summary.portfolioSimpleReturnPct)}">${fmtPct(summary.portfolioSimpleReturnPct)}</div>
        </div>
        <div class="kpi-tile secondary">
          <div class="kpi-label">Overall XIRR${infoIcon(XIRR_INFO)}</div>
          <div class="kpi-value ${pctClass(summary.portfolioXirrPct)}">${fmtPct(summary.portfolioXirrPct)}</div>
        </div>
      </div>
      <p class="kpi-asof">As of ${summary.asOfDate}</p>
    `;
  }

  const performanceFrom = document.querySelector<HTMLInputElement>('#performance-from')!;
  const performanceTo = document.querySelector<HTMLInputElement>('#performance-to')!;
  const performanceForm = document.querySelector<HTMLFormElement>('#performance-form')!;
  const performanceResult = document.querySelector<HTMLElement>('#performance-result')!;
  const performanceSubmit = performanceForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const performancePresets = [...document.querySelectorAll<HTMLButtonElement>('.performance-preset')];
  let performanceAsOf = '';
  let firstTradeDate = '';
  let currentHoldings: any[] = [];
  let selectedHoldingMovements = new Map<string, number | null>();
  let selectedActualRange: { from: string; to: string } | null = null;
  let showSincePurchase = true;

  function shiftDate(value: string, range: string): string {
    const date = new Date(`${value}T00:00:00Z`);
    if (range === '1d') date.setUTCDate(date.getUTCDate() - 1);
    if (range === '1w') date.setUTCDate(date.getUTCDate() - 7);
    if (range === '1m') date.setUTCMonth(date.getUTCMonth() - 1);
    if (range === '3m') date.setUTCMonth(date.getUTCMonth() - 3);
    if (range === 'ytd') return `${date.getUTCFullYear()}-01-01`;
    return date.toISOString().slice(0, 10);
  }

  async function loadPerformance(from: string, to: string) {
    if (!from || !to) return;
    performanceSubmit.disabled = true;
    performanceResult.innerHTML = '<p class="loading">Calculating performance…</p>';
    try {
      const params = new URLSearchParams({ from, to });
      const response = await fetch(`${API_URL}/api/portfolio/performance?${params}`);
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || `HTTP ${response.status}`);

      firstTradeDate = data.firstTradeDate;
      performanceFrom.min = firstTradeDate;
      performanceTo.min = firstTradeDate;
      performanceFrom.max = data.latestAvailableDate;
      performanceTo.max = data.latestAvailableDate;
      if (performanceFrom.value < firstTradeDate) performanceFrom.value = data.actualRange.from;
      if (performanceTo.value > data.latestAvailableDate) performanceTo.value = data.actualRange.to;
      selectedHoldingMovements = new Map(
        (data.holdingMovements || []).map((holding: any) => [holding.symbol, holding.returnPct])
      );
      selectedActualRange = data.actualRange;
      if (currentHoldings.length) renderHoldings(currentHoldings);

      const warnings = (data.warnings || []).map((warning: string) => `<p class="performance-warning">${warning}</p>`).join('');
      performanceResult.innerHTML = `
        <p class="performance-range">Showing price movement from ${data.actualRange.from} to ${data.actualRange.to}.</p>
        ${warnings}`;

      const pageUrl = new URL(window.location.href);
      pageUrl.searchParams.set('from', performanceFrom.value);
      pageUrl.searchParams.set('to', performanceTo.value);
      window.history.replaceState({}, '', pageUrl);
    } catch (error) {
      performanceResult.innerHTML = `<p class="performance-error">${error instanceof Error ? error.message : 'Could not calculate performance.'}</p>`;
    } finally {
      performanceSubmit.disabled = false;
    }
  }

  performanceForm.addEventListener('submit', (event) => {
    event.preventDefault();
    showSincePurchase = false;
    performancePresets.forEach((button) => button.classList.remove('active'));
    loadPerformance(performanceFrom.value, performanceTo.value);
  });

  performancePresets.forEach((button) => button.addEventListener('click', () => {
    const range = button.dataset.range || '1m';
    performancePresets.forEach((candidate) => candidate.classList.toggle('active', candidate === button));
    if (range === 'since-purchase') {
      showSincePurchase = true;
      performanceForm.hidden = true;
      selectedHoldingMovements.clear();
      selectedActualRange = null;
      performanceResult.innerHTML = '<p class="performance-range">Each holding is measured from its own purchase history.</p>';
      if (currentHoldings.length) renderHoldings(currentHoldings);
      const pageUrl = new URL(window.location.href);
      pageUrl.searchParams.delete('from');
      pageUrl.searchParams.delete('to');
      window.history.replaceState({}, '', pageUrl);
      return;
    }
    showSincePurchase = false;
    performanceForm.hidden = false;
    performanceTo.value = performanceAsOf;
    performanceFrom.value = shiftDate(performanceAsOf, range);
    loadPerformance(performanceFrom.value, performanceTo.value);
  }));

  function initializePerformance(asOfDate: string) {
    performanceAsOf = asOfDate;
    const pageParams = new URLSearchParams(window.location.search);
    if (pageParams.has('from') || pageParams.has('to')) {
      showSincePurchase = false;
      performanceForm.hidden = false;
      performancePresets.forEach((button) => button.classList.remove('active'));
      performanceTo.value = pageParams.get('to') || asOfDate;
      performanceFrom.value = pageParams.get('from') || shiftDate(performanceTo.value, '1m');
      loadPerformance(performanceFrom.value, performanceTo.value);
      return;
    }
    performanceTo.value = asOfDate;
    performanceFrom.value = shiftDate(asOfDate, '1m');
  }

  function renderBenchmarks(summary: any) {
    const el = document.querySelector('#benchmarks')!;
    const benchmarks = summary.benchmarks || [];
    const labels: Record<string, string> = {
      NIFTY500: 'Nifty 500', NIFTY50: 'Nifty 50', SENSEX: 'Sensex',
      NIFTY_MIDCAP: 'Nifty Midcap 50', NIFTY_SMALLCAP: 'Nifty Smallcap 250',
    };
    const row = (name: string, value: number | null, portfolio = false) => {
      const difference = !portfolio && value != null && summary.portfolioXirrPct != null
        ? summary.portfolioXirrPct - value
        : null;
      return `<div class="benchmark-row ${portfolio ? 'portfolio-row' : ''}">
        <span class="benchmark-name">${name}</span>
        <span class="benchmark-value ${pctClass(value)}">${fmtPct(value)}</span>
        <span class="benchmark-alpha ${pctClass(difference)}">${portfolio ? 'Baseline' : `${fmtPct(difference)} alpha`}</span>
      </div>`;
    };

    el.innerHTML = `
      <div class="benchmarks-block">
        <h3>XIRR comparison</h3>
        <div class="benchmark-table">
          ${row('Portfolio', summary.portfolioXirrPct, true)}
          ${benchmarks.map((benchmark: any) => row(labels[benchmark.symbol] || benchmark.symbol, benchmark.xirrPct)).join('')}
        </div>
      </div>
    `;
  }

  // Fixed hue order from the site's own accent palette, never cycled per-render,
  // assigned by the sorted order the API already returns (largest weight first).
  const ALLOC_COLORS = ['var(--leaf)', 'var(--marigold)', 'var(--coral)', 'var(--leaf-deep)', 'var(--muted)'];

  function treemap(items: { name: string; weightPct: number }[]): string {
    if (!items.length) return '<p class="loading">No data yet.</p>';
    const cells = items
      .map((item, i) => {
        const color = ALLOC_COLORS[i % ALLOC_COLORS.length];
        return `
          <div class="treemap-cell" style="flex-grow: ${item.weightPct}; background: ${color};" title="${item.name}: ${item.weightPct.toFixed(1)}%">
            <span class="treemap-name">${item.name}</span>
            <span class="treemap-value">${item.weightPct.toFixed(1)}%</span>
          </div>`;
      })
      .join('');
    const columns = items.map((item) => `${Math.max(item.weightPct, 0)}fr`).join(' ');
    return `<div class="treemap" style="grid-template-columns: ${columns};">${cells}</div>`;
  }

  function renderAllocation(alloc: any, deployedPct: number | null, cashPct: number | null) {
    const el = document.querySelector('#allocation')!;
    if (!alloc || (!alloc.bySector?.length && !alloc.byCapTier?.length)) {
      el.innerHTML = '';
      return;
    }
    const deployedCashHtml =
      deployedPct != null && cashPct != null
        ? `
        <div class="alloc-block">
          <h3>Deployed vs cash</h3>
          ${treemap([
            { name: 'Deployed', weightPct: deployedPct },
            { name: 'Cash', weightPct: cashPct },
          ])}
        </div>`
        : '';
    el.innerHTML = `
      <div class="allocation">
        <h2>Allocation</h2>
        ${deployedCashHtml}
        <div class="alloc-block">
          <h3>By sector</h3>
          ${treemap(alloc.bySector || [])}
        </div>
        <div class="alloc-block">
          <h3>By market cap</h3>
          ${treemap(alloc.byCapTier || [])}
        </div>
      </div>
    `;
  }

  function renderHoldings(holdings: any[]) {
    const el = document.querySelector('#holdings')!;
    if (!holdings.length) {
      el.innerHTML = '<p class="loading">No holdings yet.</p>';
      return;
    }

    el.innerHTML = holdings
      .map((h) => {
        const thesis = thesisMap[h.symbol];
        const thesisHtml = thesis ? `<p class="holding-thesis"><a href="${thesis.href}">Read my thesis →</a></p>` : '';
        const tierHtml = h.sizeTier ? `<span class="tier-badge tier-${h.sizeTier.toLowerCase().replace(/[^a-z]/g, '-')}">${h.sizeTier}</span>` : '';
        const hasSelectedMovement = !showSincePurchase && selectedHoldingMovements.has(h.symbol);
        const selectedMovement = hasSelectedMovement ? selectedHoldingMovements.get(h.symbol) ?? null : null;
        const selectedLabel = showSincePurchase
          ? 'Absolute return since purchase'
          : selectedActualRange
            ? `Price movement · ${selectedActualRange.from} to ${selectedActualRange.to}`
            : 'Price movement · selected period';
        const headlineReturn = showSincePurchase ? h.simpleReturnPct : selectedMovement;
        const absoluteRow = showSincePurchase
          ? ''
          : `<div class="row"><span class="label label-with-info">Absolute since purchase${infoIcon(SIMPLE_RETURN_INFO)}</span><span class="${pctClass(h.simpleReturnPct)}">${fmtPct(h.simpleReturnPct)}</span></div>`;

        return `
          <div class="holding-card ${pctClass(headlineReturn)}" data-symbol="${h.symbol}">
            <h3 class="holding-symbol">${h.symbol} ${tierHtml}</h3>
            ${thesisHtml}
            <div class="holding-headline-label">${selectedLabel}</div>
            <div class="holding-headline ${pctClass(headlineReturn)}">${showSincePurchase ? fmtPct(headlineReturn) : hasSelectedMovement ? fmtPct(selectedMovement) : 'Loading…'}</div>
            <div class="holding-stats">
              ${absoluteRow}
              <div class="row"><span class="label">Weight</span><span>${fmtPct(h.weightPct)}</span></div>
              <div class="row"><span class="label label-with-info">XIRR${infoIcon(XIRR_INFO)}</span><span class="${pctClass(h.xirrPct)}">${fmtPct(h.xirrPct)}</span></div>
              <div class="row"><span class="label">Price</span><span>${fmtPrice(h.currentPrice)}</span></div>
              <div class="row"><span class="label">Avg buy</span><span>${fmtPrice(h.avgBuyPrice)}</span></div>
            </div>
            <p class="holding-card-cta">Levels, fundamentals &amp; news →</p>
          </div>
        `;
      })
      .join('');
  }

  // Whole card navigates to the stock's detail page, except clicks on the
  // thesis link (a real <a>, kept separate since nested anchors are invalid HTML).
  document.querySelector('#holdings')!.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.holding-thesis')) return;
    const card = target.closest('.holding-card') as HTMLElement | null;
    const symbol = card?.dataset.symbol;
    if (symbol) window.location.href = `/portfolio/stock/${symbol.toLowerCase()}/`;
  });

  async function load() {
    try {
      const [summaryRes, holdingsRes, allocationRes] = await Promise.all([
        fetch(`${API_URL}/api/portfolio/summary`),
        fetch(`${API_URL}/api/portfolio/holdings`),
        fetch(`${API_URL}/api/portfolio/allocation`),
      ]);
      const summary = await summaryRes.json();
      renderKpis(summary);
      renderBenchmarks(summary);
      initializePerformance(summary.asOfDate);
      const holdingsData = await holdingsRes.json();
      currentHoldings = holdingsData.holdings || [];
      renderHoldings(currentHoldings);
      renderAllocation(await allocationRes.json(), summary.deployedPct, summary.cashPct);
    } catch {
      document.querySelector('#kpis')!.innerHTML = '<p class="loading">Could not load the portfolio right now.</p>';
      document.querySelector('#holdings')!.innerHTML = '';
    }
  }

  load();
</script>
