---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

// Static routes for the stocks this tool tracks. Must match TRACKED_SYMBOLS /
// TRACKED_STOCKS in admin.astro / worker/src/prices.js / worker/src/fundamentals.js.
export async function getStaticPaths() {
  const symbols = ['SKYGOLD', 'ANTHEM', 'KMEW', 'KRISHNADEF', 'CREDITACC'];
  return symbols.map((symbol) => ({ params: { symbol: symbol.toLowerCase() }, props: { symbol } }));
}

const { symbol } = Astro.props as { symbol: string };

const posts = await getCollection('blog');
const thesisPost = posts.find((p) => p.data.ticker === symbol);
const thesis = thesisPost ? { title: thesisPost.data.title, href: `/blog/${thesisPost.id}/` } : null;
---

<Base title={`${symbol} · Compounding Dhan`} description={`Levels, fundamentals, news and announcements for ${symbol}.`}>
  <section class="stock-page">
    <p class="hint"><a href="/portfolio">← Back to portfolio</a></p>
    <h1>{symbol}</h1>
    {thesis && <p class="hint"><a href={thesis.href}>Read my thesis →</a></p>}

    <div id="holding-stats">
      <p class="loading">Loading…</p>
    </div>

    <h2>Fundamentals</h2>
    <div id="fundamentals">
      <p class="loading">Loading…</p>
    </div>

    <h2>Price chart</h2>
    <div class="chart-legend">
      <span class="legend-item"><span class="legend-dot" style="background:#5B7FA6"></span>50 DMA</span>
      <span class="legend-item"><span class="legend-dot" style="background:#8B5CF6"></span>200 DMA</span>
    </div>
    <div id="chart-backdrop" class="chart-backdrop"></div>
    <div id="chart-wrapper" class="chart-wrapper">
      <button id="chart-maximize" class="chart-maximize-btn" type="button" title="Maximize chart" aria-label="Maximize chart">⛶</button>
      <div id="chart" class="chart-container">
        <p class="loading">Loading…</p>
      </div>
    </div>

    <h2>Levels to observe</h2>
    <div id="levels">
      <p class="loading">Loading…</p>
    </div>

    <div class="tabs">
      <button class="tab-btn filing-tab active" data-tab="announcements" type="button"><span aria-hidden="true">▤</span> NSE announcements</button>
      <button class="tab-btn news-tab" data-tab="news" type="button"><span aria-hidden="true">◉</span> News</button>
    </div>
    <ul id="announcements" class="item-list tab-panel filings-feed active">
      <li class="loading">Loading…</li>
    </ul>
    <ul id="news" class="item-list tab-panel news-feed">
      <li class="loading">Loading…</li>
    </ul>
  </section>

  <script type="application/json" id="symbol-data" set:html={JSON.stringify({ symbol })} />
</Base>

<style is:global>
  .stock-page { padding: 2rem 0 4rem; max-width: 44rem; }
  .chart-wrapper { position: relative; margin-bottom: 1rem; }
  .chart-container {
    height: 22rem; background: var(--paper); border: 2px solid var(--line);
    border-radius: var(--radius); overflow: hidden; position: relative;
  }
  .chart-container .loading { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); }
  .chart-maximize-btn {
    /* Flush in the corner, sized to match the time-axis strip height at the
       bottom of the chart so it sits neatly in that strip rather than floating
       over the candles or date labels. */
    position: absolute; bottom: 0; right: 0; z-index: 20;
    width: 1.9rem; height: 1.7rem; border-radius: 8px 0 0 0; border: 2px solid var(--line); border-right: none; border-bottom: none;
    background: var(--paper); color: var(--ink); font-size: 0.85rem; cursor: pointer;
    display: flex; align-items: center; justify-content: center; padding: 0;
  }
  .chart-maximize-btn:hover { border-color: var(--leaf); background: var(--mint); }
  .chart-wrapper.maximized .chart-maximize-btn {
    top: 1rem; right: 1rem; bottom: auto; left: auto;
    border-radius: 8px; border: 2px solid var(--line); box-shadow: 0 4px 12px rgba(21, 35, 26, 0.15);
  }
  .chart-backdrop { display: none; position: fixed; inset: 0; z-index: 999; background: rgba(21, 35, 26, 0.6); }
  .chart-backdrop.active { display: block; }
  .chart-wrapper.maximized {
    position: fixed; inset: 1.5rem; z-index: 1000; background: var(--paper);
    border-radius: var(--radius); box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35); padding: 0.5rem;
  }
  .chart-wrapper.maximized .chart-container { height: 100%; }
  .chart-line-label {
    position: absolute; left: 0.4rem; z-index: 15; transform: translateY(-50%);
    font-size: 0.68rem; font-weight: 800; background: var(--paper); padding: 0 0.3rem;
    border-radius: 4px; pointer-events: none;
  }
  .stock-page h1 { margin-bottom: 0.25rem; }
  .hint { color: var(--muted); margin-bottom: 1rem; }
  .loading { color: var(--muted); }
  h2 { margin-top: 2.25rem; margin-bottom: 0.9rem; }

  .kpi-row { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1.25rem 0; }
  .kpi-tile { background: var(--mint); border-radius: var(--radius); padding: 1.1rem 1.4rem; flex: 1 1 9rem; }
  .kpi-tile.primary { background: linear-gradient(135deg, var(--mint), var(--paper)); border: 2px solid var(--leaf); }
  .kpi-label { font-size: 0.78rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.3rem; }
  .kpi-value { font-size: 1.8rem; font-weight: 800; font-family: var(--font-display); line-height: 1; }
  .kpi-value.positive { color: var(--leaf-deep); }
  .kpi-value.negative { color: var(--coral); }

  .fund-grid, .levels-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr)); gap: 1rem; margin-bottom: 1.25rem; }
  .fund-card, .level-card { background: var(--mint); border-radius: var(--radius); padding: 1rem; }
  .fund-label, .level-label { font-size: 0.75rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .fund-value, .level-value { font-size: 1.15rem; font-weight: 800; font-family: var(--font-display); color: var(--ink); }
  .fund-card.negative { background: #FFE1E1; }

  .chart-legend { display: flex; gap: 1.1rem; font-size: 0.8rem; color: var(--muted); margin: 0 0 0.6rem; }
  .legend-item { display: flex; align-items: center; gap: 0.35rem; }
  .legend-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; display: inline-block; }

  .break-badge { font-weight: 700; font-size: 0.9rem; padding: 0.65rem 1rem; border-radius: 10px; margin: 0 0 1rem; }
  .break-badge.break-down { background: #FFF0F0; color: var(--coral); }
  .break-badge.break-up { background: var(--mint); color: var(--leaf-deep); }
  .break-badge.recovered { background: var(--line); color: var(--muted); }
  .support-resistance { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .sr-card { background: var(--paper); border: 2px solid var(--line); border-radius: var(--radius); padding: 1rem 1.25rem; }
  .sr-card h3 { margin: 0 0 0.5rem; font-size: 0.95rem; }
  .sr-card .support-value { color: var(--leaf-deep); font-weight: 700; }
  .sr-card .resistance-value { color: var(--coral); font-weight: 700; }
  .sr-card ul { margin: 0; padding-left: 1.1rem; }

  .tabs { display: flex; gap: 0.35rem; margin-top: 2rem; padding: 0.25rem; background: var(--mint); border: 1px solid var(--line); border-radius: 10px; }
  .tab-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; flex: 1;
    background: transparent; border: 1px solid transparent; padding: 0.45rem 0.65rem; border-radius: 8px;
    font: inherit; font-weight: 750; font-size: 0.82rem; color: var(--muted); cursor: pointer;
  }
  .tab-btn.active { background: var(--paper); box-shadow: 0 2px 8px rgba(21, 35, 26, 0.08); }
  .tab-btn.filing-tab.active { color: var(--marigold-deep); border-color: #E8C878; }
  .tab-btn.news-tab.active { color: var(--leaf-deep); border-color: var(--leaf); }
  .tab-panel { display: none; margin-top: 0.7rem; }
  .tab-panel.active { display: grid; }
  .show-more { list-style: none; }
  .show-more-btn {
    width: 100%; background: none; border: 2px dashed var(--line); border-radius: 12px;
    padding: 0.45rem; font: inherit; font-size: 0.78rem; font-weight: 700; color: var(--leaf-deep); cursor: pointer;
  }
  .show-more-btn:hover { border-color: var(--leaf); background: var(--mint); }
  .item-list { list-style: none; padding: 0; margin: 0; gap: 0.45rem; }
  .item { position: relative; border-radius: 8px; padding: 0.62rem 0.75rem; overflow: hidden; }
  .filings-feed .item { background: #FFF9EB; border: 1px solid #ECD9A4; border-left: 3px solid var(--marigold); }
  .news-feed .item { background: var(--mint); border: 1px solid var(--line); border-left: 3px solid var(--leaf); }
  .feed-kicker { display: flex; align-items: center; gap: 0.35rem; margin: 0 0 0.28rem; }
  .feed-badge { display: inline-flex; align-items: center; border-radius: 999px; padding: 0.1rem 0.36rem; font-size: 0.58rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
  .filing-badge { background: #F6E5B3; color: #805A00; }
  .news-badge { background: #D8EEDD; color: var(--leaf-deep); }
  .feed-date { color: var(--muted); font-size: 0.66rem; }
  .item-title { font-weight: 700; font-size: 0.86rem; line-height: 1.3; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .item-title a { color: var(--ink); }
  .item-title a:hover { color: var(--leaf-deep); }
  .item-meta { font-size: 0.7rem; color: var(--muted); }
  .item-text { margin: 0.25rem 0 0; font-size: 0.76rem; line-height: 1.35; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .filing-link { display: inline-flex; margin-top: 0.35rem; font-weight: 750; font-size: 0.7rem; color: var(--marigold-deep); }
  .fund-value.fund-text { font-size: 0.92rem; text-transform: capitalize; }
  @media (max-width: 34rem) {
    .tabs { flex-direction: column; }
    .tab-btn { width: 100%; }
  }
</style>

<script>
  import { createChart, CandlestickSeries, HistogramSeries, LineSeries } from 'lightweight-charts';

  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  const { symbol } = JSON.parse(document.querySelector('#symbol-data')?.textContent || '{}');
  function fmtPct(n: number | null): string {
    return n == null ? 'N/A' : `${n >= 0 ? '+' : ''}${n.toFixed(2)}%`;
  }
  function fmtPrice(n: number | null): string {
    return n == null ? 'N/A' : `₹${n.toFixed(2)}`;
  }
  function pctClass(n: number | null): string {
    if (n == null) return '';
    return n >= 0 ? 'positive' : 'negative';
  }
  function renderHoldingStats(holding: any) {
    const el = document.querySelector('#holding-stats')!;
    if (!holding) {
      el.innerHTML = '<p class="loading">Not currently held.</p>';
      return;
    }
    el.innerHTML = `
      <div class="kpi-row">
        <div class="kpi-tile primary">
          <div class="kpi-label">CMP</div>
          <div class="kpi-value">${fmtPrice(holding.currentPrice)}</div>
        </div>
        <div class="kpi-tile">
          <div class="kpi-label">Avg buy price</div>
          <div class="kpi-value">${fmtPrice(holding.avgBuyPrice)}</div>
        </div>
        <div class="kpi-tile">
          <div class="kpi-label">Weight</div>
          <div class="kpi-value">${fmtPct(holding.weightPct)}</div>
        </div>
        <div class="kpi-tile">
          <div class="kpi-label">XIRR</div>
          <div class="kpi-value ${pctClass(holding.xirrPct)}">${fmtPct(holding.xirrPct)}</div>
        </div>
        <div class="kpi-tile">
          <div class="kpi-label">Absolute return</div>
          <div class="kpi-value ${pctClass(holding.simpleReturnPct)}">${fmtPct(holding.simpleReturnPct)}</div>
        </div>
      </div>
    `;
  }

  // Flag genuinely poor numbers red; only claim green where there's a clear
  // "good direction" (growth, upside to target) rather than defaulting to green.
  function peClass(pe: number | null): string {
    return pe != null && pe < 0 ? 'negative' : '';
  }
  function targetClass(current: number | null, target: number | null): string {
    if (current == null || target == null) return '';
    return current > target ? 'negative' : 'positive';
  }
  function debtClass(debtToEquity: number | null): string {
    return debtToEquity != null && debtToEquity > 100 ? 'negative' : '';
  }
  function growthClass(growth: number | null): string {
    if (growth == null) return '';
    return growth < 0 ? 'negative' : 'positive';
  }
  function renderFundamentals(f: any, currentPrice: number | null) {
    const el = document.querySelector('#fundamentals')!;
    if (!f) {
      el.innerHTML = '<p class="loading">No fundamentals data yet.</p>';
      return;
    }
    const impliedTargetPct = currentPrice && f.targetMeanPrice != null ? ((f.targetMeanPrice - currentPrice) / currentPrice) * 100 : null;
    const marketCapCr = f.marketCap != null ? f.marketCap / 1e7 : null;
    const recommendation = f.recommendation ? String(f.recommendation).replaceAll('_', ' ') : 'N/A';
    el.innerHTML = `
      <p class="hint">${f.sector || 'Unknown'}${f.industry ? ' · ' + f.industry : ''} · ${f.marketCapTier ? f.marketCapTier + ' cap' : 'N/A'}</p>
      <div class="fund-grid">
        <div class="fund-card"><div class="fund-label">Market cap</div><div class="fund-value">${marketCapCr != null ? '₹' + marketCapCr.toLocaleString('en-IN', { maximumFractionDigits: 0 }) + ' Cr' : 'N/A'}</div></div>
        <div class="fund-card ${peClass(f.peRatio)}"><div class="fund-label">P/E</div><div class="fund-value">${f.peRatio != null ? f.peRatio.toFixed(1) : 'N/A'}</div></div>
        <div class="fund-card ${peClass(f.forwardPe)}"><div class="fund-label">Forward P/E</div><div class="fund-value">${f.forwardPe != null ? f.forwardPe.toFixed(1) : 'N/A'}</div></div>
        <div class="fund-card ${targetClass(currentPrice, f.targetMeanPrice)}"><div class="fund-label">Analyst target</div><div class="fund-value">${fmtPrice(f.targetMeanPrice)}</div></div>
        <div class="fund-card ${growthClass(impliedTargetPct)}"><div class="fund-label">Implied target return</div><div class="fund-value">${fmtPct(impliedTargetPct)}</div></div>
        <div class="fund-card"><div class="fund-label">Target range</div><div class="fund-value">${fmtPrice(f.targetLowPrice)}–${fmtPrice(f.targetHighPrice)}</div></div>
        <div class="fund-card"><div class="fund-label">Recommendation</div><div class="fund-value fund-text">${recommendation}</div></div>
        <div class="fund-card ${debtClass(f.debtToEquity)}"><div class="fund-label">Debt/Equity</div><div class="fund-value">${f.debtToEquity != null ? f.debtToEquity.toFixed(1) + '%' : 'N/A'}</div></div>
        <div class="fund-card ${growthClass(f.revenueGrowth)}"><div class="fund-label">Revenue growth YoY</div><div class="fund-value">${f.revenueGrowth != null ? fmtPct(f.revenueGrowth * 100) : 'N/A'}</div></div>
        <div class="fund-card ${growthClass(f.revenueGrowthQoq)}"><div class="fund-label">Revenue growth QoQ</div><div class="fund-value">${f.revenueGrowthQoq != null ? fmtPct(f.revenueGrowthQoq * 100) : 'N/A'}</div></div>
        <div class="fund-card ${growthClass(f.earningsGrowth)}"><div class="fund-label">Profit growth YoY</div><div class="fund-value">${f.earningsGrowth != null ? fmtPct(f.earningsGrowth * 100) : 'N/A'}</div></div>
        <div class="fund-card ${growthClass(f.profitGrowthQoq)}"><div class="fund-label">Profit growth QoQ</div><div class="fund-value">${f.profitGrowthQoq != null ? fmtPct(f.profitGrowthQoq * 100) : 'N/A'}</div></div>
        <div class="fund-card"><div class="fund-label">Latest quarter profit</div><div class="fund-value">${f.latestQuarterProfitCr != null ? '₹' + f.latestQuarterProfitCr.toFixed(2) + ' Cr' : 'N/A'}</div></div>
        <div class="fund-card ${f.profitAtRecentHigh === false ? 'negative' : ''}"><div class="fund-label">Profit vs recent high</div><div class="fund-value fund-text">${f.profitAtRecentHigh == null ? 'N/A' : f.profitAtRecentHigh ? 'At 4-quarter high' : fmtPct(f.profitPctOffRecentHigh) + ' below'}</div></div>
      </div>
    `;
  }

  function renderLevels(l: any) {
    const el = document.querySelector('#levels')!;
    if (!l) {
      el.innerHTML = '<p class="loading">No price history yet.</p>';
      return;
    }
    const rb = l.recentBreak;
    const daysAgoText = (d: number) => `${d} day${d === 1 ? '' : 's'} ago`;
    const breakWhen = rb?.breakDate
      ? `${new Date(`${rb.breakDate}T00:00:00`).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' })} (${daysAgoText(rb.daysAgo)})`
      : daysAgoText(rb?.daysAgo || 0);
    const breakBadge =
      rb && rb.broke === 'support'
        ? `<p class="break-badge break-down ${rb.stillBroken ? '' : 'recovered'}">↓ Broke below prior support at ${fmtPrice(rb.level)} on ${breakWhen}${rb.stillBroken ? ', still below it' : ', since recovered back above it'}</p>`
        : rb && rb.broke === 'resistance'
        ? `<p class="break-badge break-up ${rb.stillBroken ? '' : 'recovered'}">↑ Broke above prior resistance at ${fmtPrice(rb.level)} on ${breakWhen}${rb.stillBroken ? ', still above it' : ', since fallen back below it'}</p>`
        : '';

    el.innerHTML = `
      <div class="levels-grid">
        <div class="level-card"><div class="level-label">52-week high</div><div class="level-value">${fmtPrice(l.week52High)}</div></div>
        <div class="level-card"><div class="level-label">52-week low</div><div class="level-value">${fmtPrice(l.week52Low)}</div></div>
        <div class="level-card"><div class="level-label">50-day avg</div><div class="level-value">${fmtPrice(l.dma50)}</div></div>
        <div class="level-card"><div class="level-label">200-day avg</div><div class="level-value">${fmtPrice(l.dma200)}</div></div>
      </div>
      ${breakBadge}
      <div class="support-resistance">
        <div class="sr-card">
          <h3>Support</h3>
          ${l.support.length ? `<ul>${l.support.map((p: number, i: number) => `<li class="support-value">S${i + 1} · ${fmtPrice(p)}</li>`).join('')}</ul>` : '<p class="hint">Not enough history yet.</p>'}
        </div>
        <div class="sr-card">
          <h3>Resistance</h3>
          ${l.resistance.length ? `<ul>${l.resistance.map((p: number, i: number) => `<li class="resistance-value">R${i + 1} · ${fmtPrice(p)}</li>`).join('')}</ul>` : '<p class="hint">Not enough history yet.</p>'}
        </div>
      </div>
    `;
  }

  // Renders the first `limit` items, then a "Show N more" toggle for the rest,
  // so a 10-item feed doesn't force a long scroll for something skimmable.
  function renderExpandableList(el: Element, items: any[], itemHtml: (item: any) => string, emptyText: string, limit = 5) {
    if (!items.length) {
      el.innerHTML = `<li class="loading">${emptyText}</li>`;
      return;
    }
    let visible = Math.min(limit, items.length);
    el.innerHTML = items.slice(0, visible).map(itemHtml).join('');
    if (visible >= items.length) return;
    const moreLi = document.createElement('li');
    moreLi.className = 'show-more';
    const updateButton = () => {
      const nextCount = Math.min(limit, items.length - visible);
      moreLi.innerHTML = `<button class="show-more-btn" type="button">Show ${nextCount} more ▾</button>`;
      moreLi.querySelector('button')!.addEventListener('click', showNext);
    };
    const showNext = () => {
      const next = items.slice(visible, visible + limit);
      moreLi.insertAdjacentHTML('beforebegin', next.map(itemHtml).join(''));
      visible += next.length;
      if (visible >= items.length) moreLi.remove();
      else updateButton();
    };
    updateButton();
    el.appendChild(moreLi);
  }

  function renderNews(news: any[]) {
    renderExpandableList(
      document.querySelector('#news')!,
      news,
      (n) => `
        <li class="item">
          <p class="feed-kicker"><span class="feed-badge news-badge">${n.source || 'News'}</span><span class="feed-date">${n.pubDate ? new Date(n.pubDate).toLocaleDateString('en-IN') : ''}</span></p>
          <p class="item-title"><a href="${n.link}" target="_blank" rel="noopener">${n.title}</a></p>
        </li>
      `,
      'No recent news found.'
    );
  }

  function renderAnnouncements(announcements: any[]) {
    renderExpandableList(
      document.querySelector('#announcements')!,
      announcements,
      (a) => `
        <li class="item">
          <p class="feed-kicker"><span class="feed-badge filing-badge">NSE filing</span><span class="feed-date">${a.date || ''}</span></p>
          <p class="item-title">${a.subject || 'Announcement'}</p>
          ${a.text ? `<p class="item-text">${a.text}</p>` : ''}
          ${a.url ? `<a class="filing-link" href="${a.url}" target="_blank" rel="noopener">Open exchange document →</a>` : ''}
        </li>
      `,
      'No recent announcements found.'
    );
  }

  function renderChart(
    prices: { date: string; open: number; high: number; low: number; close: number; volume: number | null }[],
    support: number[],
    resistance: number[],
    avgBuyPrice: number | null,
    dma50Series: { time: string; value: number }[],
    dma200Series: { time: string; value: number }[]
  ) {
    const container = document.querySelector('#chart') as HTMLElement;
    if (!prices.length) {
      container.innerHTML = '<p class="loading">Not enough price history yet.</p>';
      return;
    }
    container.innerHTML = '';

    const chart = createChart(container, {
      width: container.clientWidth,
      height: container.clientHeight,
      layout: { background: { color: 'transparent' }, textColor: '#5C6B5F', fontFamily: 'inherit', attributionLogo: false },
      grid: { vertLines: { visible: false }, horzLines: { color: '#E6E2D4' } },
      rightPriceScale: { borderColor: '#E6E2D4' },
      // rightOffset leaves empty space after the last candle so the cluster of
      // price-line labels (S1/R1/Avg buy/current price) doesn't sit on top of it.
      timeScale: { borderColor: '#E6E2D4', rightOffset: 12 },
      crosshair: { mode: 0 },
      // Explicit (not just relying on library defaults): wheel zooms, drag pans,
      // pinch zooms on touch, dragging the price/time axis rescales that axis.
      handleScroll: { mouseWheel: true, pressedMouseMove: true, horzTouchDrag: true, vertTouchDrag: true },
      handleScale: { mouseWheel: true, pinch: true, axisPressedMouseMove: true },
    });

    const series = chart.addSeries(CandlestickSeries, {
      upColor: '#16A34A',
      downColor: '#FB5E5E',
      borderUpColor: '#0C7036',
      borderDownColor: '#E14B4B',
      wickUpColor: '#16A34A',
      wickDownColor: '#FB5E5E',
      priceFormat: { type: 'custom', formatter: (p: number) => `₹${p.toFixed(2)}` },
    });
    // Leave the bottom ~22% of the pane clear for the volume histogram below.
    series.priceScale().applyOptions({ scaleMargins: { top: 0.08, bottom: 0.22 } });
    series.setData(
      prices
        .filter((p) => p.open != null && p.high != null && p.low != null)
        .map((p) => ({ time: p.date, open: p.open, high: p.high, low: p.low, close: p.close }))
    );

    // Volume bars pinned to the bottom of the same pane, own price scale (an
    // overlay, not the shared right-hand price axis) so it never fights candle scaling.
    const volumeSeries = chart.addSeries(HistogramSeries, {
      priceFormat: { type: 'volume' },
      priceScaleId: 'volume',
      color: '#5C6B5F',
    });
    volumeSeries.priceScale().applyOptions({ scaleMargins: { top: 0.82, bottom: 0 } });
    volumeSeries.setData(
      prices
        .filter((p) => p.volume != null)
        .map((p) => ({ time: p.date, value: p.volume, color: p.close >= p.open ? 'rgba(22, 163, 74, 0.5)' : 'rgba(251, 94, 94, 0.5)' }))
    );

    // 50/200-day moving averages plotted as curved lines directly on the price
    // pane — shows a golden/death cross as an actual line intersection rather
    // than a text badge.
    const dma50LineSeries = chart.addSeries(LineSeries, {
      color: '#5B7FA6', lineWidth: 1, lineType: 2, priceLineVisible: false, lastValueVisible: false, crosshairMarkerVisible: false,
    });
    dma50LineSeries.setData(dma50Series);
    const dma200LineSeries = chart.addSeries(LineSeries, {
      color: '#8B5CF6', lineWidth: 1, lineType: 2, priceLineVisible: false, lastValueVisible: false, crosshairMarkerVisible: false,
    });
    dma200LineSeries.setData(dma200Series);

    // Support (floor) below current price, resistance (ceiling) above, and where
    // you actually bought in — drawn as horizontal reference lines. lightweight-charts'
    // built-in `title` only shows up combined with the axis badge (not as a separate
    // on-pane label in this version), so labels are custom-positioned DOM elements
    // pinned to the left edge, at the exact pixel Y the library reports for that price —
    // see updateLabelPositions() below, always visible, no hover needed.
    // S1/R1 = nearest to current price, S2/R2 next, etc. (both arrays already sorted that way).
    const priceLevels: { price: number; label: string; color: string }[] = [];
    support.forEach((price, i) => {
      series.createPriceLine({ price, color: '#16A34A', lineWidth: 1, lineStyle: 2, axisLabelVisible: false });
      priceLevels.push({ price, label: `S${i + 1}`, color: '#16A34A' });
    });
    resistance.forEach((price, i) => {
      series.createPriceLine({ price, color: '#FB5E5E', lineWidth: 1, lineStyle: 2, axisLabelVisible: false });
      priceLevels.push({ price, label: `R${i + 1}`, color: '#FB5E5E' });
    });
    if (avgBuyPrice != null) {
      series.createPriceLine({ price: avgBuyPrice, color: '#F59E0B', lineWidth: 2, lineStyle: 0, axisLabelVisible: false });
      priceLevels.push({ price: avgBuyPrice, label: 'Avg buy', color: '#F59E0B' });
    }

    const labelEls = priceLevels.map((l) => {
      const el = document.createElement('div');
      el.className = 'chart-line-label';
      el.style.color = l.color;
      el.textContent = l.label;
      container.appendChild(el);
      return { el, price: l.price };
    });
    function updateLabelPositions() {
      for (const { el, price } of labelEls) {
        const y = series.priceToCoordinate(price);
        if (y == null) {
          el.style.display = 'none';
          continue;
        }
        el.style.display = 'block';
        el.style.top = `${y}px`;
      }
    }
    chart.timeScale().subscribeVisibleLogicalRangeChange(updateLabelPositions);

    // All loaded history stays in the series (needed for DMA200/golden-cross/volume
    // profile) — only the *default view* is the last year; scroll/zoom out for the rest.
    // Use a logical range because date ranges are clamped to the final data point,
    // which can silently remove future whitespace. Twelve empty bar slots keep the
    // latest candle away from the right-hand price scale at every screen width.
    const lastLogicalIndex = prices.length - 1;
    const visibleTradingDays = 252;
    const trailingGapBars = 12;
    chart.timeScale().setVisibleLogicalRange({
      from: Math.max(0, lastLogicalIndex - visibleTradingDays + 1),
      to: lastLogicalIndex + trailingGapBars,
    });
    updateLabelPositions();

    new ResizeObserver(() => {
      chart.applyOptions({ width: container.clientWidth, height: container.clientHeight });
      updateLabelPositions();
    }).observe(container);
  }

  async function load() {
    // Fired independently rather than bundled into one request — news and NSE
    // announcements hit slow, best-effort external sources (several seconds),
    // while holdings/levels/price-history are our own DB and fast. Each section
    // renders as soon as its own fetch resolves instead of everything waiting
    // on the slowest one.
    const holdingsPromise = fetch(`${API_URL}/api/portfolio/holdings`).then((r) => r.json());
    const levelsPromise = fetch(`${API_URL}/api/portfolio/levels?symbol=${encodeURIComponent(symbol)}`).then((r) => r.json());
    const priceHistoryPromise = fetch(`${API_URL}/api/portfolio/price-history?symbol=${encodeURIComponent(symbol)}&days=1095`).then((r) => r.json());

    fetch(`${API_URL}/api/portfolio/fundamentals?symbol=${encodeURIComponent(symbol)}`)
      .then((r) => r.json())
      .then(async (data) => {
        const holdingsData = await holdingsPromise.catch(() => ({ holdings: [] }));
        const holding = (holdingsData.holdings || []).find((h: any) => h.symbol === symbol) || null;
        renderFundamentals(data.fundamentals, holding?.currentPrice ?? null);
      })
      .catch(() => {
        document.querySelector('#fundamentals')!.innerHTML = '<p class="loading">Could not load fundamentals.</p>';
      });

    fetch(`${API_URL}/api/portfolio/news?symbol=${encodeURIComponent(symbol)}`)
      .then((r) => r.json())
      .then((data) => renderNews(data.news || []))
      .catch(() => {
        document.querySelector('#news')!.innerHTML = '<li class="loading">Could not load news.</li>';
      });

    fetch(`${API_URL}/api/portfolio/announcements?symbol=${encodeURIComponent(symbol)}`)
      .then((r) => r.json())
      .then((data) => renderAnnouncements(data.announcements || []))
      .catch(() => {
        document.querySelector('#announcements')!.innerHTML = '<li class="loading">Could not load announcements.</li>';
      });

    try {
      const holdingsData = await holdingsPromise;
      const holding = (holdingsData.holdings || []).find((h: any) => h.symbol === symbol) || null;
      renderHoldingStats(holding);

      const [levelsData, priceHistory] = await Promise.all([levelsPromise, priceHistoryPromise]);
      const levels = levelsData.levels || {};
      renderLevels(levels);
      renderChart(
        priceHistory.prices || [],
        levels.support || [],
        levels.resistance || [],
        holding?.avgBuyPrice ?? null,
        levels.dma50Series || [],
        levels.dma200Series || []
      );
    } catch {
      document.querySelector('#holding-stats')!.innerHTML = '<p class="loading">Could not load this stock right now.</p>';
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.tab-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach((b) => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach((p) => p.classList.remove('active'));
      btn.classList.add('active');
      document.querySelector(`#${btn.dataset.tab}`)!.classList.add('active');
    });
  });

  // Reuses the same chart instance — toggling these classes resizes the existing
  // #chart container, and the ResizeObserver already set up in renderChart() picks
  // that up and calls chart.applyOptions() automatically. No second chart needed.
  const chartWrapper = document.querySelector('#chart-wrapper')!;
  const chartBackdrop = document.querySelector('#chart-backdrop')!;
  const maximizeBtn = document.querySelector<HTMLButtonElement>('#chart-maximize')!;

  function setMaximized(on: boolean) {
    chartWrapper.classList.toggle('maximized', on);
    chartBackdrop.classList.toggle('active', on);
    maximizeBtn.textContent = on ? '✕' : '⛶';
    maximizeBtn.title = on ? 'Close' : 'Maximize chart';
  }
  maximizeBtn.addEventListener('click', () => setMaximized(!chartWrapper.classList.contains('maximized')));
  chartBackdrop.addEventListener('click', () => setMaximized(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && chartWrapper.classList.contains('maximized')) setMaximized(false);
  });

  load();
</script>
