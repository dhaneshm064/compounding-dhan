---
import Base from '../layouts/Base.astro';
---

<Base title="Capital Flows · Compounding Dhan" description="Publicly disclosed bulk and block deals.">
  <section class="flows-page">
    <p class="back-link"><a href="/portfolio">← Portfolio</a></p>
    <h1>Capital Flows</h1>
    <p class="intro">Publicly disclosed bulk and block deals from the exchanges, refreshed on trading days — a research feed, not a real-time view of private HNI activity or an investment recommendation.</p>

    <section id="whales-panel" class="flow-panel whales-panel">
      <div class="section-heading whale-heading"><div><h2>Top disclosed whales</h2><p class="flow-meta">Returns are based only on matched disclosed buys and later sells.</p></div><label class="whale-sort">Sort <select id="whale-sort" aria-label="Sort whale leaderboard"><option value="buyValue">Buy value</option><option value="hitRatePct">Hit rate</option><option value="medianReturnPct">Median return</option><option value="matchedTrades">Matched trades</option></select></label></div>
      <div id="whale-list" class="flow-list"><p class="loading">Loading whale activity…</p></div>
      <div id="whale-pages" class="deal-pages" aria-label="Whale leaderboard pages"></div>
    </section>

    <section id="deals-panel" class="flow-panel">
      <div class="section-heading"><h2>Bulk &amp; block deals</h2></div>
      <div id="client-focus" class="client-focus" hidden></div>
      <div class="deal-options">
        <div class="deal-options-row">
          <div class="deal-filters">
            <label>Type <select id="deal-type" aria-label="Deal type"><option value="">Bulk + block</option><option value="bulk">Bulk only</option><option value="block">Block only</option></select></label>
            <label>From <input id="deal-from" type="date" aria-label="Start date" /></label>
            <label>To <input id="deal-to" type="date" aria-label="End date" /></label>
            <label>Client <input id="deal-client" type="search" placeholder="Search client" aria-label="Client name" /></label>
            <button id="apply-deal-filters" type="button">Apply</button>
          </div>
          <span id="deal-count" class="flow-meta"></span>
        </div>
        <details class="more-filters">
          <summary>More filters</summary>
          <div class="more-filters-body">
            <label><input id="show-intraday" type="checkbox" /> Show likely intraday pairs</label>
            <label class="min-value">Minimum deal value <span class="filter-input"><input id="min-value" type="number" min="0" step="0.1" inputmode="decimal" placeholder="0" aria-label="Minimum deal value in crore" /> <span>₹ Cr</span></span></label>
          </div>
        </details>
      </div>
      <div id="deal-list" class="flow-list"><p class="loading">Loading deals…</p></div>
      <div id="deal-pages" class="deal-pages" aria-label="Deal pages"></div>
    </section>
  </section>
</Base>

<style is:global>
  .container:has(.flows-page) { max-width: 100%; }
  .flows-page { padding: 2rem clamp(1.25rem, 3vw, 3.5rem) 4rem; max-width: none; }
  .back-link { margin-bottom: 1rem; }
  .intro { margin: 0 0 1.5rem; color: var(--muted); max-width: 44rem; line-height: 1.55; }
  .flow-panel { padding: 1.25rem; border: 1px solid var(--line); border-radius: 1rem; background: color-mix(in srgb, var(--paper) 86%, var(--paper-2)); box-shadow: 0 8px 24px rgba(44, 35, 20, .05); }
  .whales-panel { margin-bottom: 1.25rem; }
  .whale-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .whale-sort { display: inline-flex; align-items: center; gap: .45rem; color: var(--muted); font-size: .78rem; white-space: nowrap; }
  .whale-sort select { border: 1px solid var(--line); border-radius: .35rem; background: var(--paper); color: var(--ink); padding: .28rem .4rem; font: inherit; }
  .section-heading { margin-bottom: .85rem; }
  .section-heading h2 { margin: 0; font-size: 1.2rem; }
  .flow-list { display: grid; gap: .7rem; }
  .deal-table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: .7rem; background: var(--paper); }
  .deal-options { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin: 0 0 1rem; padding: .75rem; border: 1px solid var(--line); border-radius: .65rem; background: var(--paper-2); color: var(--muted); font-size: .78rem; }
  .deal-filters { display: flex; align-items: center; flex-wrap: wrap; gap: .8rem 1.2rem; }
  .deal-options label { display: inline-flex; align-items: center; gap: .45rem; cursor: pointer; }
  .deal-options input { accent-color: var(--leaf); }
  .filter-input { display: inline-flex; align-items: center; gap: .25rem; border: 1px solid var(--line); border-radius: .35rem; background: var(--paper); padding: .15rem .4rem; color: var(--muted); }
  .filter-input input { width: 4.5rem; border: 0; outline: 0; background: transparent; color: var(--ink); font: inherit; text-align: right; }
  .deal-options select, .deal-options input[type="date"] { border: 1px solid var(--line); border-radius: .35rem; background: var(--paper); color: var(--ink); padding: .28rem .4rem; font: inherit; }
  .deal-options input[type="search"] { width: 10rem; border: 1px solid var(--line); border-radius: .35rem; background: var(--paper); color: var(--ink); padding: .28rem .4rem; font: inherit; }
  .deal-options button { border: 1px solid var(--leaf); border-radius: .35rem; background: var(--leaf); color: white; padding: .32rem .65rem; font: inherit; font-weight: 700; cursor: pointer; }
  .deal-pages { display: flex; align-items: center; justify-content: center; gap: .45rem; margin-top: .85rem; }
  .deal-pages button { border: 1px solid var(--line); border-radius: .35rem; background: var(--paper); color: var(--ink); padding: .35rem .65rem; cursor: pointer; }
  .deal-pages button[aria-current="page"] { background: var(--leaf); border-color: var(--leaf); color: white; font-weight: 700; }
  .deal-pages button:disabled { opacity: .45; cursor: default; }
  .deal-table { width: 100%; min-width: 72rem; border-collapse: separate; border-spacing: 0; font-size: .86rem; }
  .deal-table th { position: sticky; top: 0; z-index: 1; background: var(--paper-2); color: var(--muted); font-size: .72rem; letter-spacing: .06em; text-align: left; text-transform: uppercase; white-space: nowrap; }
  .deal-table th, .deal-table td { padding: .82rem .95rem; border-bottom: 1px solid var(--line); border-right: 1px solid var(--line); vertical-align: middle; line-height: 1.45; }
  .deal-table th:last-child, .deal-table td:last-child { border-right: 0; }
  .deal-table tbody tr:nth-child(even) { background: color-mix(in srgb, var(--paper-2) 42%, transparent); }
  .deal-table tbody tr:hover { background: var(--mint); }
  .deal-table tbody tr:last-child td { border-bottom: 0; }
  .deal-table td strong { font-family: var(--font-display); }
  .deal-table .stock { min-width: 10rem; }
  .deal-table .stock-link { display: inline-flex; align-items: baseline; gap: .45rem; margin-bottom: .28rem; white-space: nowrap; }
  .deal-table .exchange { color: var(--muted); font-size: .78rem; font-weight: 700; }
  .deal-table .number { text-align: right; white-space: nowrap; }
  .deal-table .date { white-space: nowrap; }
  .deal-table .client { min-width: 18rem; max-width: 28rem; }
  .client-link { max-width: 27rem; overflow: hidden; border: 0; padding: 0; background: transparent; color: var(--ink); font: inherit; text-align: left; text-decoration: underline; text-decoration-color: color-mix(in srgb, var(--leaf) 55%, transparent); text-underline-offset: .16em; cursor: pointer; }
  .client-link:hover { color: var(--leaf); }
  .deal-table .deal-type, .deal-table .action { display: inline-block; border-radius: 999px; padding: .18rem .48rem; font-size: .67rem; font-weight: 800; text-transform: uppercase; white-space: nowrap; }
  .deal-table .deal-type { background: var(--paper-2); color: var(--muted); }
  .deal-table .buy { background: #e7f7ed; color: #16733b; }
  .deal-table .sell { background: #fff0f0; color: #c94b4b; }
  .deal-table a { white-space: nowrap; font-weight: 700; }
  .whale-table { min-width: 62rem; }
  .whale-table .rank { width: 3rem; color: var(--muted); font-weight: 700; }
  .whale-table .whale-name { min-width: 20rem; max-width: 30rem; }
  .whale-table .metric-positive { color: #16733b; font-weight: 750; }
  .whale-table .metric-negative { color: #c94b4b; font-weight: 750; }
  .flow-meta { color: var(--muted); font-size: .76rem; }
  .client-focus { display: flex; align-items: center; justify-content: space-between; gap: .75rem; margin: 0 0 1rem; padding: .65rem .8rem; border: 1px solid color-mix(in srgb, var(--leaf) 45%, var(--line)); border-radius: .55rem; background: var(--mint); color: var(--ink); font-size: .82rem; }
  .client-focus button { border: 0; background: transparent; color: var(--leaf-deep); cursor: pointer; font: inherit; font-weight: 700; text-decoration: underline; }
  .empty { padding: 1rem; border: 2px dashed var(--line); border-radius: var(--radius); color: var(--muted); font-size: .85rem; }
  @media (max-width: 720px) {
    .flow-panel { padding: .85rem; }
    .deal-options { align-items: flex-start; flex-direction: column; }
    .deal-count { align-self: flex-end; }
  }
</style>

<script>
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8787';
  const escapeHtml = (value: unknown) => String(value ?? '').replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char] || char));
  const pct = (value: number | null) => value == null ? 'Not available' : `${value >= 0 ? '+' : ''}${value.toFixed(2)}%`;
  const date = (value: string | null) => value ? new Date(value).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : 'Date unavailable';
  const crore = (value: number | null) => value == null ? '—' : `₹${(Number(value) / 10000000).toFixed(1)} Cr`;

  let allDeals: any[] = [];
  const showIntraday = document.querySelector<HTMLInputElement>('#show-intraday')!;
  const minValue = document.querySelector<HTMLInputElement>('#min-value')!;
  const dealType = document.querySelector<HTMLSelectElement>('#deal-type')!;
  const dealFrom = document.querySelector<HTMLInputElement>('#deal-from')!;
  const dealTo = document.querySelector<HTMLInputElement>('#deal-to')!;
  const dealClient = document.querySelector<HTMLInputElement>('#deal-client')!;
  const applyFilters = document.querySelector<HTMLButtonElement>('#apply-deal-filters')!;
  const dealCount = document.querySelector<HTMLElement>('#deal-count')!;
  const dealPages = document.querySelector<HTMLElement>('#deal-pages')!;
  const clientFocus = document.querySelector<HTMLElement>('#client-focus')!;
  let page = 1;
  let totalPages = 1;
  let reportedTotal = 0;
  let whaleData: any[] = [];
  let whalePage = 1;
  const whalePageSize = 10;

  function renderWhales(whales: any[]) {
    const el = document.querySelector('#whale-list')!;
    if (!whales.length) { el.innerHTML = '<p class="empty">No disclosed whale activity is available yet.</p>'; return; }
    const sortKey = (document.querySelector<HTMLSelectElement>('#whale-sort')?.value || 'buyValue');
    const sorted = [...whales].sort((a, b) => {
      const aValue = a[sortKey] == null ? -Infinity : Number(a[sortKey]);
      const bValue = b[sortKey] == null ? -Infinity : Number(b[sortKey]);
      return bValue - aValue || Number(b.buyValue || 0) - Number(a.buyValue || 0);
    });
    const totalWhalePages = Math.max(1, Math.ceil(sorted.length / whalePageSize));
    whalePage = Math.min(whalePage, totalWhalePages);
    const pageItems = sorted.slice((whalePage - 1) * whalePageSize, whalePage * whalePageSize);
    el.innerHTML = `<div class="deal-table-wrap"><table class="deal-table whale-table"><thead><tr><th>#</th><th>Client</th><th class="number">Buy value</th><th class="number">Deals</th><th class="number">Stocks</th><th class="number">Matched trades</th><th class="number">Hit rate</th><th class="number">Median return</th><th class="number">Median hold</th><th>Last active</th></tr></thead><tbody>${pageItems.map((item, index) => {
      const returnClass = item.medianReturnPct == null ? '' : item.medianReturnPct >= 0 ? 'metric-positive' : 'metric-negative';
      const hitRate = item.hitRatePct == null ? '—' : `${item.hitRatePct.toFixed(1)}%`;
      const medianReturn = item.medianReturnPct == null ? '—' : `${item.medianReturnPct >= 0 ? '+' : ''}${item.medianReturnPct.toFixed(2)}%`;
      const rank = (whalePage - 1) * whalePageSize + index + 1;
      return `<tr><td class="rank">${rank}</td><td class="whale-name"><button class="client-link whale-client" type="button" data-client="${escapeHtml(item.clientName)}">${escapeHtml(item.clientName)}</button></td><td class="number"><strong>${crore(item.buyValue)}</strong></td><td class="number">${item.deals.toLocaleString('en-IN')}</td><td class="number">${item.stocks.toLocaleString('en-IN')}</td><td class="number">${item.matchedTrades || '—'}</td><td class="number">${hitRate}</td><td class="number ${returnClass}">${medianReturn}</td><td class="number">${item.medianHoldingDays == null ? '—' : `${item.medianHoldingDays}d`}</td><td class="date">${escapeHtml(date(item.lastActivity))}</td></tr>`;
    }).join('')}</tbody></table></div><p class="flow-meta">Hit rate and median return use only FIFO-matched disclosed buys and later sells. Unmatched holdings are excluded.</p>`;
    const pages = document.querySelector('#whale-pages')!;
    pages.innerHTML = totalWhalePages <= 1 ? '' : `<button type="button" data-whale-page="${whalePage - 1}" ${whalePage === 1 ? 'disabled' : ''}>Previous</button><span class="flow-meta">Page ${whalePage} of ${totalWhalePages}</span><button type="button" data-whale-page="${whalePage + 1}" ${whalePage === totalWhalePages ? 'disabled' : ''}>Next</button>`;
  }

  fetch(`${API_URL}/api/portfolio/capital-flows/whales?limit=50`, { cache: 'no-store' }).then(async (response) => {
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || 'Could not load whale activity');
    whaleData = data.whales || [];
    renderWhales(whaleData);
  }).catch(() => {
    document.querySelector('#whale-list')!.innerHTML = '<p class="empty">Whale activity is temporarily unavailable.</p>';
  });
  document.querySelector<HTMLSelectElement>('#whale-sort')!.addEventListener('change', () => { whalePage = 1; renderWhales(whaleData); });
  document.querySelector('#whale-pages')!.addEventListener('click', (event) => {
    const next = Number((event.target as HTMLElement).dataset.whalePage);
    if (next >= 1 && next <= Math.ceil(whaleData.length / whalePageSize)) { whalePage = next; renderWhales(whaleData); }
  });

  function renderDeals(items: any[] = allDeals) {
    const el = document.querySelector('#deal-list')!;
    const visible = showIntraday.checked ? items : items.filter((item) => !item.intraday);
    dealCount.textContent = `${visible.length} shown · ${reportedTotal || items.length} reported`;
    if (!visible.length) { el.innerHTML = '<p class="empty">No deals match these filters. Try lowering the minimum value or enabling likely intraday pairs.</p>'; return; }
    el.innerHTML = `<div class="deal-table-wrap"><table class="deal-table"><thead><tr><th>Stock</th><th>Client name</th><th>Exchange</th><th>Deal type</th><th>Action</th><th>Date</th><th class="number">Avg. price</th><th class="number">Quantity</th><th class="number">Value</th><th>Intraday</th></tr></thead><tbody>${visible.map((item) => `<tr><td class="stock"><a class="stock-link" href="https://www.screener.in/company/${encodeURIComponent(item.symbol)}/" target="_blank" rel="noopener noreferrer"><strong>${escapeHtml(item.symbol)}</strong></a></td><td class="client"><button class="client-link" type="button" data-client="${escapeHtml(item.clientName)}" title="View all disclosed deals by this client">${escapeHtml(item.clientName)}</button></td><td class="exchange">${escapeHtml(item.exchange || 'NSE')}</td><td><span class="deal-type">${escapeHtml(item.type)}</span></td><td><span class="action ${item.side === 'BUY' ? 'buy' : 'sell'}">${escapeHtml(item.side)}</span></td><td class="date">${escapeHtml(date(item.date))}</td><td class="number">₹${Number(item.price).toFixed(2)}</td><td class="number">${Number(item.quantity).toLocaleString('en-IN')}</td><td class="number">${item.value == null ? '—' : `₹${(Number(item.value) / 10000000).toFixed(2)} Cr`}</td><td>${item.intraday ? '<span class="flow-meta">Likely pair</span>' : '—'}</td></tr>`).join('')}</tbody></table></div>`;
    dealPages.innerHTML = totalPages <= 1 ? '' : `<button type="button" data-page="${page - 1}" ${page === 1 ? 'disabled' : ''}>Previous</button><span class="flow-meta">Page ${page} of ${totalPages}</span><button type="button" data-page="${page + 1}" ${page === totalPages ? 'disabled' : ''}>Next</button>`;
  }

  showIntraday.addEventListener('change', () => renderDeals());
  minValue.addEventListener('change', () => { page = 1; loadDeals(); });
  applyFilters.addEventListener('click', () => { page = 1; loadDeals(); });
  document.querySelector('#deal-list')!.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const client = target.closest<HTMLButtonElement>('.client-link')?.dataset.client;
    if (!client) return;
    dealClient.value = client;
    dealFrom.value = '';
    dealTo.value = '';
    showClientHistory(client);
    page = 1;
    loadDeals();
  });
  document.querySelector('#whale-list')!.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const client = target.closest<HTMLButtonElement>('.whale-client')?.dataset.client;
    if (!client) return;
    dealClient.value = client;
    dealFrom.value = '';
    dealTo.value = '';
    showClientHistory(client);
    page = 1;
    loadDeals();
  });
  clientFocus.addEventListener('click', () => {
    dealClient.value = '';
    dealFrom.value = localDate(1);
    dealTo.value = localDate(0);
    clientFocus.hidden = true;
    page = 1;
    loadDeals();
  });
  dealPages.addEventListener('click', (event) => { const target = event.target as HTMLElement; const nextPage = Number(target.dataset.page); if (nextPage >= 1 && nextPage <= totalPages) { page = nextPage; loadDeals(); } });

  function loadDeals() {
    const params = new URLSearchParams({ page: String(page), pageSize: '25' });
    if (dealType.value) params.set('type', dealType.value);
    if (dealFrom.value) params.set('from', dealFrom.value);
    if (dealTo.value) params.set('to', dealTo.value);
    if (minValue.value) params.set('minValue', minValue.value);
    if (dealClient.value.trim()) params.set('client', dealClient.value.trim());
    return fetch(`${API_URL}/api/portfolio/capital-flows?${params}`, { cache: 'no-store' }).then(async (response) => {
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || 'Could not load capital flows');
    allDeals = data.deals || [];
    reportedTotal = data.pagination?.total || allDeals.length;
    totalPages = data.pagination?.pages || 1;
    renderDeals();
    if (dealClient.value.trim()) document.querySelector('#deals-panel')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }).catch(() => {
    document.querySelector('#deal-list')!.innerHTML = '<p class="empty">Capital-flow data is temporarily unavailable. Please try again later.</p>';
    dealPages.innerHTML = '';
  });
  }
  function showClientHistory(client) {
    clientFocus.hidden = false;
    clientFocus.innerHTML = `<span>Viewing disclosed history for <strong>${escapeHtml(client)}</strong></span><button type="button">Clear client</button>`;
  }
  function localDate(daysAgo = 0) {
    const value = new Date();
    value.setDate(value.getDate() - daysAgo);
    return `${value.getFullYear()}-${String(value.getMonth() + 1).padStart(2, '0')}-${String(value.getDate()).padStart(2, '0')}`;
  }
  const initialClient = new URLSearchParams(window.location.search).get('client');
  if (initialClient) {
    dealClient.value = initialClient;
  } else {
    dealFrom.value = localDate(1);
    dealTo.value = localDate(0);
  }
  loadDeals();
</script>
