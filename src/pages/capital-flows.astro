---
import Base from '../layouts/Base.astro';
import '../styles/capital-flows.css';
---

<Base title="Capital Flows · Compounding Dhan" description="Publicly disclosed bulk and block deals.">
  <section class="flows-page">
    <p class="back-link"><a href="/portfolio">← Portfolio</a></p>
    <h1>Capital Flows</h1>
    <p class="intro">Publicly disclosed NSE and BSE bulk and block deals, fetched every evening after the exchanges publish them; the investor leaderboard is rebuilt nightly. A research feed, not a real-time view of private activity or an investment recommendation.</p>

    <form id="flows-search" class="flows-search" role="search">
      <select id="search-kind" aria-label="Search for"><option value="stock">Stock</option><option value="client">Client</option></select>
      <input id="search-text" type="search" placeholder="Stock symbol, e.g. ANTHEM" aria-label="Stock symbol or client name" autocomplete="off" />
      <button type="submit">Open</button>
    </form>

    <section id="deals-panel" class="flow-panel panel-gap">
      <div class="section-heading"><h2 id="deals-heading">Latest bulk &amp; block deals</h2><p id="deal-coverage" class="flow-meta"></p></div>
      <div class="deal-options">
        <div class="deal-options-row">
          <div class="deal-filters">
            <label>Type <select id="deal-type" aria-label="Deal type"><option value="">Bulk + block</option><option value="bulk">Bulk only</option><option value="block">Block only</option></select></label>
            <label>From <input id="deal-from" type="date" aria-label="Start date" /></label>
            <label>To <input id="deal-to" type="date" aria-label="End date" /></label>
            <label class="min-value">Min value <span class="filter-input"><input id="min-value" type="number" min="0" step="0.1" inputmode="decimal" placeholder="0" aria-label="Minimum deal value in crore" /> <span>₹ Cr</span></span></label>
            <button id="apply-deal-filters" type="button">Apply</button>
            <button id="latest-day" type="button">Latest day</button>
            <label class="intraday-filter"><input id="hide-prop" type="checkbox" checked /> Hide prop / HFT desks</label>
            <label class="intraday-filter"><input id="show-intraday" type="checkbox" /> Include likely intraday pairs</label>
          </div>
          <span id="deal-count" class="flow-meta"></span>
        </div>
      </div>
      <div id="deal-list" class="flow-list"><p class="loading">Loading deals…</p></div>
      <div id="deal-pages" class="deal-pages" aria-label="Deal pages"></div>
    </section>

    <section id="whales-panel" class="flow-panel whales-panel">
      <div class="section-heading whale-heading">
        <div><h2>Top disclosed investors</h2><p class="flow-meta">Returns use only matched disclosed buys and later sells. Client types are inferred from names and trading behaviour.</p><p id="whale-coverage" class="flow-meta"></p></div>
        <div class="whale-controls">
          <label class="whale-sort"><input id="whale-include-same-day" type="checkbox" /> Include same-day trades</label>
          <label class="whale-sort">Sort <select id="whale-sort" aria-label="Sort investor leaderboard"><option value="buyValue">Buy value</option><option value="hitRatePct">Hit rate</option><option value="medianReturnPct" selected>Median return</option><option value="matchedTrades">Matched trades</option></select></label>
          <label class="whale-sort">Min complete trades <input id="whale-min-matched" type="number" min="0" step="1" value="10" aria-label="Minimum complete trades" /></label>
        </div>
      </div>
      <div id="type-chips" class="type-chips panel-gap" aria-label="Client types"></div>
      <div id="whale-list" class="flow-list"><p class="loading">Loading investors…</p></div>
      <div id="whale-pages" class="deal-pages" aria-label="Leaderboard pages"></div>
    </section>
  </section>
</Base>

<script>
  import { CLIENT_TYPES } from '../lib/capital-flows.js';
  import { API_URL, escapeHtml, date, crore, qty, price, clientLink, stockLink, clientHref, stockHref, loadClientMeta, typeOf, typeBadge, pager } from '../lib/capital-flows-ui';

  // Old links to /capital-flows?client=… now have their own page.
  const legacyClient = new URLSearchParams(window.location.search).get('client');
  if (legacyClient) window.location.replace(clientHref(legacyClient));

  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const dealType = $<HTMLSelectElement>('#deal-type');
  const dealFrom = $<HTMLInputElement>('#deal-from');
  const dealTo = $<HTMLInputElement>('#deal-to');
  const minValue = $<HTMLInputElement>('#min-value');
  const hideProp = $<HTMLInputElement>('#hide-prop');
  const showIntraday = $<HTMLInputElement>('#show-intraday');
  const dealCount = $('#deal-count');
  const dealPages = $('#deal-pages');
  const metaPromise = loadClientMeta();

  // ---------- Search ----------
  const searchKind = $<HTMLSelectElement>('#search-kind');
  const searchText = $<HTMLInputElement>('#search-text');
  searchKind.addEventListener('change', () => {
    searchText.placeholder = searchKind.value === 'stock' ? 'Stock symbol, e.g. ANTHEM' : 'Client name, e.g. SBI MUTUAL FUND';
  });
  $('#flows-search').addEventListener('submit', (event) => {
    event.preventDefault();
    const text = searchText.value.trim();
    if (!text) return;
    window.location.href = searchKind.value === 'stock' ? stockHref(text.toUpperCase()) : clientHref(text.toUpperCase());
  });

  // ---------- Deals ----------
  let deals: any[] = [];
  let page = 1;
  let totalPages = 1;
  let reported = 0;
  let latestMode = true;
  let propFilter = 'off';
  let sortKey = 'value';
  let sortDir: 'asc' | 'desc' = 'desc';
  const pageSize = 50;
  const columns: [string, string, string?][] = [
    ['stock', 'Stock'], ['client', 'Client'], ['action', 'Action'], ['value', 'Value', 'number'],
    ['price', 'Avg. price', 'number'], ['quantity', 'Quantity', 'number'], ['date', 'Date'], ['exchange', 'Exchange'], ['type', 'Deal type'],
  ];

  function coverageText(coverage: Record<string, string | null | undefined>) {
    const parts = Object.entries(coverage || {}).filter(([, latest]) => latest).map(([exchange, latest]) => `${exchange} ${date(String(latest))}`);
    return parts.length ? `Data through ${parts.join(' · ')}` : '';
  }

  async function renderDeals() {
    const meta = await metaPromise;
    const el = $('#deal-list');
    // Prop and intraday filtering happens in the API before paging; this only labels rows.
    const visible = deals.map((d) => ({ ...d, clientType: typeOf(d.clientName, meta) }));
    dealCount.textContent = `${reported.toLocaleString('en-IN')} deals${propFilter === 'unavailable' ? ' · prop filter unavailable right now' : ''}`;
    if (!visible.length) {
      el.innerHTML = '<p class="empty">No deals match these filters. Try a wider date range, or include prop desks and intraday pairs.</p>';
    } else {
      const header = columns.map(([key, label, align = '']) => {
        const active = sortKey === key;
        return `<th class="${align}" aria-sort="${active ? (sortDir === 'asc' ? 'ascending' : 'descending') : 'none'}"><button class="deal-sort ${align}" type="button" data-sort="${key}" aria-pressed="${active}">${label}<span class="sort-arrow" aria-hidden="true">${active ? (sortDir === 'asc' ? '↑' : '↓') : '↕'}</span></button></th>`;
      }).join('');
      el.innerHTML = `<div class="deal-table-wrap"><table class="deal-table"><thead><tr>${header}</tr></thead><tbody>${visible.map((d) => `<tr>
        <td class="stock" data-label="Stock">${stockLink(d.symbol)}</td>
        <td class="client" data-label="Client">${clientLink(d.clientName)} ${d.clientType === 'individual' || d.clientType === 'corporate' ? '' : typeBadge(d.clientType)}</td>
        <td data-label="Action"><span class="action ${d.side === 'BUY' ? 'buy' : 'sell'}">${escapeHtml(d.side)}</span>${d.intraday ? ' <span class="flow-meta" title="Bought and sold the same stock that day">same-day</span>' : ''}</td>
        <td class="number" data-label="Value"><strong>${crore(d.value, 2)}</strong></td>
        <td class="number" data-label="Avg. price">${price(d.price)}</td>
        <td class="number" data-label="Quantity">${qty(d.quantity)}</td>
        <td class="date" data-label="Date">${escapeHtml(date(d.date))}</td>
        <td class="exchange" data-label="Exchange">${escapeHtml(d.exchange || 'NSE')}</td>
        <td data-label="Deal type"><span class="deal-type">${escapeHtml(d.type)}</span></td></tr>`).join('')}</tbody></table></div>`;
    }
    dealPages.innerHTML = totalPages <= 1 ? '' : `<button type="button" data-page="${page - 1}" ${page === 1 ? 'disabled' : ''}>Previous</button><span class="flow-meta">Page ${page} of ${totalPages}</span><button type="button" data-page="${page + 1}" ${page === totalPages ? 'disabled' : ''}>Next</button>`;
  }

  async function loadDeals() {
    const params = new URLSearchParams({ page: String(page), pageSize: String(pageSize), sort: sortKey, direction: sortDir });
    if (latestMode) params.set('latest', '1');
    else {
      if (dealFrom.value) params.set('from', dealFrom.value);
      if (dealTo.value) params.set('to', dealTo.value);
    }
    if (dealType.value) params.set('type', dealType.value);
    if (minValue.value) params.set('minValue', minValue.value);
    if (hideProp.checked) params.set('hideProp', '1');
    if (!showIntraday.checked) params.set('excludeIntraday', '1');
    try {
      const response = await fetch(`${API_URL}/api/portfolio/capital-flows?${params}`);
      const data = await response.json();
      if (!response.ok) throw new Error(data.error);
      deals = data.deals || [];
      propFilter = data.propFilter || 'off';
      reported = data.pagination?.total || deals.length;
      totalPages = data.pagination?.pages || 1;
      if (latestMode && data.pagination?.from) {
        dealFrom.value = data.pagination.from;
        dealTo.value = data.pagination.to || data.pagination.from;
        $('#deals-heading').textContent = `Bulk & block deals · ${date(data.pagination.from)}`;
      } else {
        $('#deals-heading').textContent = 'Bulk & block deals';
      }
      if (data.coverage) {
        const latest = Object.fromEntries(Object.entries(data.coverage as Record<string, Record<string, string | null>>)
          .map(([exchange, types]) => [exchange, Object.values(types).filter(Boolean).sort().at(-1)]));
        $('#deal-coverage').textContent = coverageText(latest);
      }
      await renderDeals();
    } catch {
      $('#deal-list').innerHTML = '<p class="empty">Capital-flow data is temporarily unavailable. Please try again later.</p>';
      dealPages.innerHTML = '';
    }
  }

  $('#apply-deal-filters').addEventListener('click', () => { latestMode = !dealFrom.value && !dealTo.value; page = 1; loadDeals(); });
  $('#latest-day').addEventListener('click', () => { latestMode = true; page = 1; loadDeals(); });
  [dealFrom, dealTo].forEach((input) => input.addEventListener('change', () => { latestMode = false; }));
  minValue.addEventListener('change', () => { page = 1; loadDeals(); });
  dealType.addEventListener('change', () => { page = 1; loadDeals(); });
  hideProp.addEventListener('change', () => { page = 1; loadDeals(); });
  showIntraday.addEventListener('change', () => { page = 1; loadDeals(); });
  $('#deal-list').addEventListener('click', (event) => {
    const key = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-sort]')?.dataset.sort;
    if (!key) return;
    sortDir = sortKey === key && sortDir === 'desc' ? 'asc' : 'desc';
    sortKey = key;
    page = 1;
    loadDeals();
  });
  dealPages.addEventListener('click', (event) => {
    const next = Number((event.target as HTMLElement).dataset.page);
    if (next >= 1 && next <= totalPages) { page = next; loadDeals(); }
  });

  // ---------- Investor leaderboard ----------
  let whales: any[] = [];
  let whalePage = 1;
  const whalePageSize = 15;
  const minMatched = $<HTMLInputElement>('#whale-min-matched');
  const includeSameDay = $<HTMLInputElement>('#whale-include-same-day');
  const typeChips = $('#type-chips');
  typeChips.innerHTML = Object.entries(CLIENT_TYPES).map(([type, label]) =>
    `<label><input type="checkbox" value="${type}" ${type === 'prop' ? '' : 'checked'} /> ${escapeHtml(label)}</label>`).join('');
  const selectedTypes = () => new Set([...typeChips.querySelectorAll<HTMLInputElement>('input:checked')].map((input) => input.value));

  function metric(item: any, key: string) {
    if (includeSameDay.checked) return item[key];
    const positional: Record<string, string> = { matchedTrades: 'positionalMatchedTrades', hitRatePct: 'positionalHitRatePct', medianReturnPct: 'positionalMedianReturnPct' };
    return item[positional[key] || key];
  }

  function renderWhales() {
    const el = $('#whale-list');
    const types = selectedTypes();
    const min = Math.max(0, Number(minMatched.value) || 0);
    const eligible = whales.filter((w) => types.has(w.type) && Number(metric(w, 'matchedTrades') || 0) >= min);
    if (!eligible.length) { el.innerHTML = '<p class="empty">No investors match these filters.</p>'; $('#whale-pages').innerHTML = ''; return; }
    const key = $<HTMLSelectElement>('#whale-sort').value;
    const sorted = [...eligible].sort((a, b) => {
      const av = metric(a, key) == null ? -Infinity : Number(metric(a, key));
      const bv = metric(b, key) == null ? -Infinity : Number(metric(b, key));
      return bv - av || b.buyValue - a.buyValue;
    });
    const pages = Math.max(1, Math.ceil(sorted.length / whalePageSize));
    whalePage = Math.min(whalePage, pages);
    const items = sorted.slice((whalePage - 1) * whalePageSize, whalePage * whalePageSize);
    el.innerHTML = `<div class="deal-table-wrap"><table class="deal-table whale-table"><thead><tr><th>#</th><th>Investor</th><th>Type</th><th class="number">Buy value</th><th class="number">Deals</th><th class="number">Stocks</th><th class="number">Matched trades</th><th class="number">Hit rate</th><th class="number">Median return</th><th class="number" title="Median holding period for matches held beyond the purchase date">Median hold</th><th>Last active</th></tr></thead><tbody>${items.map((w, i) => {
      const ret = metric(w, 'medianReturnPct');
      const hit = metric(w, 'hitRatePct');
      const hold = w.medianHoldingDays == null && Number(w.sameDayMatchedLots || 0) > 0 ? 'Same-day only' : w.medianHoldingDays == null ? '-' : `${w.medianHoldingDays}d`;
      return `<tr>
        <td class="rank" data-label="#">${(whalePage - 1) * whalePageSize + i + 1}</td>
        <td class="whale-name" data-label="Investor">${clientLink(w.clientName)}</td>
        <td data-label="Type">${typeBadge(w.type)}</td>
        <td class="number" data-label="Buy value"><strong>${crore(w.buyValue)}</strong></td>
        <td class="number" data-label="Deals">${qty(w.deals)}</td>
        <td class="number" data-label="Stocks">${qty(w.stocks)}</td>
        <td class="number" data-label="Matched trades">${metric(w, 'matchedTrades') || '-'}</td>
        <td class="number" data-label="Hit rate">${hit == null ? '-' : `${Number(hit).toFixed(1)}%`}</td>
        <td class="number ${ret == null ? '' : ret >= 0 ? 'metric-positive' : 'metric-negative'}" data-label="Median return">${ret == null ? '-' : `${ret >= 0 ? '+' : ''}${Number(ret).toFixed(2)}%`}</td>
        <td class="number" data-label="Median hold">${hold}</td>
        <td class="date" data-label="Last active">${escapeHtml(date(w.lastActivity))}</td></tr>`;
    }).join('')}</tbody></table></div><p class="flow-meta">Hit rate and median return use FIFO-matched disclosed buys and later sells. Unmatched holdings are excluded.</p>`;
    $('#whale-pages').innerHTML = pager(sorted.length, whalePage, whalePageSize, 'whale-page');
  }

  fetch('/data/whales-summary.json').then(async (response) => {
    const data = await response.json();
    if (!response.ok) throw new Error();
    whales = data.whales || [];
    $('#whale-coverage').textContent = coverageText(data.dataThrough);
    renderWhales();
  }).catch(() => { $('#whale-list').innerHTML = '<p class="empty">Investor activity is temporarily unavailable.</p>'; });
  [$('#whale-sort'), includeSameDay, minMatched, typeChips].forEach((el) => el.addEventListener('change', () => { whalePage = 1; renderWhales(); }));
  $('#whale-pages').addEventListener('click', (event) => {
    const next = Number((event.target as HTMLElement).dataset.whalePage);
    if (next >= 1) { whalePage = next; renderWhales(); }
  });

  loadDeals();
</script>
