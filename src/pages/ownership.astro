---
import Base from '../layouts/Base.astro';
import '../styles/capital-flows.css';
---

<Base title="Ownership Radar · Compounding Dhan" description="Where domestic and foreign institutions and promoters raised or cut their holdings last quarter, from companies' shareholding filings.">
  <section class="flows-page ownership-screen">
    <p class="back-link"><a href="/capital-flows">← Capital Flows</a></p>
    <h1>Ownership Radar</h1>
    <p class="intro">Stocks institutions and promoters added to or cut last quarter, from every NSE company's quarterly shareholding filing. Newest quarter fills in over ~3 weeks. Research only, not a recommendation.</p>

    <section class="flow-panel panel-gap">
      <div class="section-heading"><h2 id="screen-heading">Institutional accumulation</h2><p id="screen-coverage" class="flow-meta"></p></div>
      <div class="deal-options">
        <div class="deal-options-row">
          <div class="deal-filters">
            <label>Quarter <select id="quarter" aria-label="Quarter"></select></label>
            <label>Stock <input id="search" type="search" placeholder="Symbol or name" autocomplete="off" /></label>
            <label>Holder <select id="holder" aria-label="Holder to screen on"><option value="dii">DII</option><option value="fii">FII</option><option value="promoter">Promoter</option></select></label>
            <label>Show <select id="direction" aria-label="Direction"><option value="up">Adding</option><option value="down">Cutting</option><option value="all">All</option></select></label>
            <label class="min-value">Min change <span class="filter-input"><input id="min-change" type="number" min="0" step="0.1" value="0.5" inputmode="decimal" aria-label="Minimum change in percentage points" /> <span>pp</span></span></label>
            <label class="min-value">Min holding <span class="filter-input"><input id="min-pct" type="number" min="0" step="0.5" value="0" inputmode="decimal" aria-label="Minimum holding of the selected holder" /> <span>%</span></span></label>
            <label class="intraday-filter"><input id="new-schemes" type="checkbox" /> New MF scheme above 1%</label>
            <label class="intraday-filter"><input id="with-deals" type="checkbox" /> With MF bulk/block buys</label>
          </div>
          <span id="count" class="flow-meta"></span>
        </div>
      </div>
      <div id="list" class="flow-list"><p class="loading">Loading ownership data…</p></div>
      <div id="pages" class="deal-pages" aria-label="Pages"></div>
      <p class="flow-meta">Hover a column name for what it shows. pp = percentage points. A share issue can lower every holder's percentage without any selling.</p>
    </section>
  </section>
</Base>

<style is:global>
  /* Global: these rows are built in the browser, outside Astro's style scoping. */
  .ownership-screen .spark { display: block; }
  .ownership-screen .scheme-list { color: var(--muted); font-size: .74rem; line-height: 1.3; min-width: 10rem; max-width: 13rem; }
  .ownership-screen .stock-name { display: block; color: var(--muted); font-size: .72rem; max-width: 13rem; white-space: normal; }
  .ownership-screen .pos { color: #2f9e5b; font-weight: 700; }
  .ownership-screen .neg { color: #d06060; font-weight: 700; }
  .ownership-screen .group-row th { text-align: center; font-size: .72rem; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); border-bottom: 0; padding-bottom: .1rem; }
  .ownership-screen .group-start { border-left: 1px solid var(--line); }
  /* Many columns: tighter cells so the table fits a laptop screen. */
  .ownership-screen .deal-table th, .ownership-screen .deal-table td { padding-left: .5rem; padding-right: .5rem; }
  .ownership-screen .deal-table .deal-sort { gap: .2rem; }
</style>

<script>
  import { escapeHtml, crore, stockHref, sortableTable, handleSortClick, pager } from '../lib/capital-flows-ui';

  type Row = Record<string, any>;
  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const quarterSelect = $<HTMLSelectElement>('#quarter');
  const search = $<HTMLInputElement>('#search');
  const holder = $<HTMLSelectElement>('#holder');
  const direction = $<HTMLSelectElement>('#direction');
  const minChange = $<HTMLInputElement>('#min-change');
  const minPct = $<HTMLInputElement>('#min-pct');
  const newSchemes = $<HTMLInputElement>('#new-schemes');
  const withDeals = $<HTMLInputElement>('#with-deals');
  const pageSize = 20;
  let rows: Row[] = [];
  let history: string[] = [];
  let page = 1;
  const sortState: { key: string; dir: 'asc' | 'desc' } = { key: 'dii', dir: 'desc' };
  // Selected holder -> its holding, change and history fields.
  const HOLDERS: Record<string, { pct: string; change: string; history: string; label: string }> = {
    dii: { pct: 'diiPct', change: 'diiChange', history: 'diiHistory', label: 'DII' },
    fii: { pct: 'fpiPct', change: 'fiiChange', history: 'fpiHistory', label: 'FII' },
    promoter: { pct: 'promoterPct', change: 'promoterChange', history: 'promoterHistory', label: 'Promoter' },
  };

  const quarterLabel = (period: string) => {
    const [y, m] = period.split('-');
    return `${['Mar', 'Jun', 'Sep', 'Dec'][Math.floor(Number(m) / 3) - 1]} ${y}`;
  };
  const pp = (v: number | null) => v == null ? '-' : `${v > 0 ? '+' : ''}${v.toFixed(2)}`;
  const sparkline = (values: (number | null)[]) => {
    const points = values.map((v, i) => [i, v] as const).filter(([, v]) => v != null) as [number, number][];
    if (points.length < 2) return '';
    const max = Math.max(...points.map(([, v]) => v), 1);
    const w = 64, h = 22, step = w / Math.max(values.length - 1, 1);
    const path = points.map(([i, v], n) => `${n ? 'L' : 'M'}${(i * step).toFixed(1)},${(h - 2 - (v / max) * (h - 4)).toFixed(1)}`).join('');
    const title = `${HOLDERS[holder.value].label}: ` + values.map((v, i) => `${quarterLabel(history[i])} ${v == null ? '-' : `${v}%`}`).join(', ');
    return `<svg class="spark" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" role="img" aria-label="${escapeHtml(title)}"><title>${escapeHtml(title)}</title><path d="${path}" fill="none" stroke="var(--leaf)" stroke-width="1.6"/></svg>`;
  };

  const holderChange = (now: number | null, prev: number | null) => now == null || prev == null ? null : Math.round((now - prev) * 100) / 100;
  const holding = (now: number | null) => now == null ? '-' : `<strong>${now.toFixed(2)}%</strong>`;
  const changeCell = (change: number | null) => change == null ? '-' : `<span class="${change > 0 ? 'pos' : change < 0 ? 'neg' : ''}">${pp(change)}</span>`;

  /** "NIPPON LIFE INDIA TRUSTEE LTD-A/C NIPPON INDIA SMALL CAP FUND" -> "NIPPON INDIA SMALL CAP FUND". */
  const shortScheme = (name: string) => name.replace(/^.*\bA\/C\.?\s*/i, '').replace(/^.*TRUSTEE\s+(?:CO(?:MPANY)?\.?\s+)?(?:PVT\.?\s+)?(?:LTD|LIMITED)\.?\s*[-–]\s*/i, '').replace(/^.*?MUTUAL FUND\s*-\s*/i, '').trim() || name;

  const tip = (label: string, title: string) => `<span title="${title}">${label}</span>`;
  const columns: [string, string, boolean?][] = [
    ['symbol', 'Stock'],
    ['diiPct', 'Holding', true], ['dii', 'Change', true],
    ['fpiPct', 'Holding', true], ['fii', 'Change', true],
    ['promoterPct', 'Holding', true], ['promoter', 'Change', true],
    ['schemes', tip('MF schemes', 'Mutual fund schemes (part of DII) holding the stock and the change; below, schemes newly above 1% (hover for all)')],
    ['deals', tip('MF deals', 'Mutual funds\' bulk/block buys and sells in the quarter'), true],
    ['trend', tip('Trend', 'Selected holder over up to 8 quarters')],
  ];
  const sortValue: Record<string, (r: Row) => unknown> = {
    symbol: (r) => r.symbol, diiPct: (r) => r.diiPct, fpiPct: (r) => r.fpiPct, promoterPct: (r) => r.promoterPct, dii: (r) => r.diiChange, fii: (r) => r.fiiChange,
    promoter: (r) => r.promoterChange, schemes: (r) => r.schemesChange, deals: (r) => r.mfDealBuy - r.mfDealSell, trend: (r) => r[HOLDERS[holder.value].change],
  };

  function filtered() {
    const text = search.value.trim().toUpperCase();
    const min = Math.max(0, Number(minChange.value) || 0);
    const minHolding = Math.max(0, Number(minPct.value) || 0);
    const h = HOLDERS[holder.value];
    return rows.filter((r) => {
      if (text && !r.symbol.includes(text) && !String(r.name).toUpperCase().includes(text)) return false;
      if ((r[h.pct] ?? 0) < minHolding) return false;
      const change = r[h.change];
      if (direction.value === 'up' && !((change ?? 0) >= Math.max(min, 0.01))) return false;
      if (direction.value === 'down' && !((change ?? 0) <= -Math.max(min, 0.01))) return false;
      if (direction.value === 'all' && Math.abs(change ?? 0) < min) return false;
      if (newSchemes.checked && !r.newSchemes.length) return false;
      if (withDeals.checked && !r.mfDealBuy) return false;
      return true;
    });
  }

  // Group header over each Holding/Change pair; explanations in tooltips.
  const groupHeader = [
    '<th></th>',
    `<th colspan="2" class="group-start">${tip('DII', 'Domestic institutions: mutual funds, insurance, pension funds, banks, AIFs; change in percentage points (pp)')}</th>`,
    `<th colspan="2" class="group-start">${tip('FII', 'Foreign portfolio investors (FPI); excludes strategic foreign stakes')}</th>`,
    `<th colspan="2" class="group-start">${tip('Promoter', 'Promoter and promoter group')}</th>`,
    '<th colspan="3"></th>',
  ].join('');

  function render() {
    const { header, sort } = sortableTable<Row>(columns.map(([k, l, n]) => [k, l, n]), sortState, 'sort');
    const all = sort(filtered(), (r, key) => sortValue[key](r));
    const pages = Math.max(1, Math.ceil(all.length / pageSize));
    page = Math.min(page, pages);
    $('#count').textContent = `${all.length.toLocaleString('en-IN')} stocks`;
    const list = $('#list');
    if (!all.length) {
      list.innerHTML = '<p class="empty">No stocks match these filters. Try a smaller minimum change.</p>';
    } else {
      list.innerHTML = `<div class="deal-table-wrap"><table class="deal-table"><thead><tr class="group-row">${groupHeader}</tr><tr>${header}</tr></thead><tbody>${all.slice((page - 1) * pageSize, page * pageSize).map((r) => {
        const shown = r.newSchemes.slice(0, 2).map((n: string) => escapeHtml(shortScheme(n))).join('<br>');
        const more = r.newSchemes.length > 2 ? `<br>+${r.newSchemes.length - 2} more` : '';
        const allSchemes = escapeHtml(r.newSchemes.map(shortScheme).join('\n'));
        const deals = r.mfDealBuy || r.mfDealSell
          ? `${r.mfDealBuy ? `<span class="pos">${crore(r.mfDealBuy)}</span>` : ''}${r.mfDealBuy && r.mfDealSell ? ' / ' : ''}${r.mfDealSell ? `<span class="neg">−${crore(r.mfDealSell)}</span>` : ''}`
          : '-';
        return `<tr>
          <td class="stock" data-label="Stock"><a class="entity-link" href="${stockHref(r.symbol)}"><strong>${escapeHtml(r.symbol)}</strong></a><span class="stock-name">${escapeHtml(r.name)}</span></td>
          <td class="number group-start" data-label="DII holding">${holding(r.diiPct)}</td>
          <td class="number" data-label="DII change">${changeCell(r.diiChange)}</td>
          <td class="number group-start" data-label="FII holding">${holding(r.fpiPct)}</td>
          <td class="number" data-label="FII change">${changeCell(r.fiiChange)}</td>
          <td class="number group-start" data-label="Promoter holding">${holding(r.promoterPct)}</td>
          <td class="number" data-label="Promoter change">${changeCell(r.promoterChange)}</td>
          <td class="group-start" data-label="MF schemes"><strong>${r.mfHolders ?? 0}</strong>${r.schemesChange ? ` <span class="${r.schemesChange > 0 ? 'pos' : 'neg'}">(${r.schemesChange > 0 ? '+' : ''}${r.schemesChange})</span>` : ''}${shown ? `<div class="scheme-list" title="${allSchemes}">${shown + more}</div>` : ''}</td>
          <td class="number" data-label="MF deals">${deals}</td>
          <td data-label="Trend">${sparkline(r[HOLDERS[holder.value].history] || [])}</td></tr>`;
      }).join('')}</tbody></table></div>`;
    }
    $('#pages').innerHTML = pager(all.length, page, pageSize, 'page');
  }

  async function loadQuarter(period: string) {
    $('#list').innerHTML = '<p class="loading">Loading…</p>';
    const data = await (await fetch(`/data/ownership/screen/${period}.json`)).json();
    history = data.history;
    rows = data.rows.map((values: unknown[]) => {
      const r: Row = Object.fromEntries(data.columns.map((c: string, i: number) => [c, values[i]]));
      r.diiChange = holderChange(r.diiPct, r.diiPctPrev);
      r.fiiChange = holderChange(r.fpiPct, r.fpiPctPrev);
      r.promoterChange = holderChange(r.promoterPct, r.promoterPctPrev);
      r.schemesChange = r.mfHoldersPrev == null ? null : (r.mfHolders ?? 0) - r.mfHoldersPrev;
      return r;
    });
    $('#screen-heading').textContent = `Institutional accumulation · ${quarterLabel(data.period)} vs ${quarterLabel(data.previous)}`;
    page = 1;
    render();
  }

  fetch('/data/ownership/index.json').then((r) => r.json()).then(async (index) => {
    const counts = new Map<string, number>(index.quarters);
    quarterSelect.innerHTML = index.screens.map((p: string) => `<option value="${p}">${quarterLabel(p)}</option>`).join('');
    const update = () => {
      const p = quarterSelect.value;
      $('#screen-coverage').textContent = `${(counts.get(p) || 0).toLocaleString('en-IN')} companies have filed for ${quarterLabel(p)}`;
      loadQuarter(p);
    };
    quarterSelect.addEventListener('change', update);
    update();
  }).catch(() => { $('#list').innerHTML = '<p class="empty">Ownership data is temporarily unavailable.</p>'; });

  [search, direction, minChange, minPct, newSchemes, withDeals].forEach((el) => el.addEventListener('input', () => { page = 1; render(); }));
  holder.addEventListener('input', () => { page = 1; render(); });
  // Biggest moves of the selected holder first, in either direction.
  [holder, direction].forEach((el) => el.addEventListener('input', () => { sortState.key = holder.value; sortState.dir = direction.value === 'down' ? 'asc' : 'desc'; render(); }));
  $('#list').addEventListener('click', (event) => { if (handleSortClick(event, 'sort', sortState)) { page = 1; render(); } });
  $('#pages').addEventListener('click', (event) => {
    const next = Number((event.target as HTMLElement).dataset.page);
    if (next >= 1) { page = next; render(); }
  });
</script>
