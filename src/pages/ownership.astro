---
import Base from '../layouts/Base.astro';
import '../styles/capital-flows.css';
---

<Base title="Ownership Radar · Compounding Dhan" description="Where mutual funds raised or cut their holdings last quarter, from companies' shareholding filings.">
  <section class="flows-page ownership-screen">
    <p class="back-link"><a href="/capital-flows">← Capital Flows</a></p>
    <h1>Ownership Radar</h1>
    <p class="intro">Stocks mutual funds added to or cut last quarter, from every NSE company's quarterly shareholding filing. Newest quarter fills in over ~3 weeks. Research only, not a recommendation.</p>

    <section class="flow-panel panel-gap">
      <div class="section-heading"><h2 id="screen-heading">Mutual fund accumulation</h2><p id="screen-coverage" class="flow-meta"></p></div>
      <div class="deal-options">
        <div class="deal-options-row">
          <div class="deal-filters">
            <label>Quarter <select id="quarter" aria-label="Quarter"></select></label>
            <label>Stock <input id="search" type="search" placeholder="Symbol or name" autocomplete="off" /></label>
            <label>Show <select id="direction" aria-label="Direction"><option value="up">Funds adding</option><option value="down">Funds cutting</option><option value="all">All</option></select></label>
            <label class="min-value">Min change <span class="filter-input"><input id="min-change" type="number" min="0" step="0.1" value="0.5" inputmode="decimal" aria-label="Minimum change in percentage points" /> <span>pp</span></span></label>
            <label class="min-value">Min MF holding <span class="filter-input"><input id="min-pct" type="number" min="0" step="0.5" value="0" inputmode="decimal" aria-label="Minimum mutual fund holding" /> <span>%</span></span></label>
            <label class="intraday-filter"><input id="new-schemes" type="checkbox" /> New fund above 1%</label>
            <label class="intraday-filter"><input id="with-deals" type="checkbox" /> With fund bulk/block buys</label>
          </div>
          <span id="count" class="flow-meta"></span>
        </div>
      </div>
      <div id="list" class="flow-list"><p class="loading">Loading ownership data…</p></div>
      <div id="pages" class="deal-pages" aria-label="Pages"></div>
      <p class="flow-meta">Hover a column name for what it shows. pp = percentage points. A share issue can lower a holding without any selling, so check the share change; * = adjusted for a split or bonus.</p>
    </section>
  </section>
</Base>

<style is:global>
  /* Global: these rows are built in the browser, outside Astro's style scoping. */
  .ownership-screen .spark { display: block; }
  .ownership-screen .scheme-list { color: var(--muted); font-size: .74rem; line-height: 1.3; min-width: 12rem; max-width: 16rem; }
  .ownership-screen .stock-name { display: block; color: var(--muted); font-size: .72rem; max-width: 13rem; white-space: normal; }
  .ownership-screen .pos { color: #2f9e5b; font-weight: 700; }
  .ownership-screen .neg { color: #d06060; font-weight: 700; }
</style>

<script>
  import { escapeHtml, crore, stockHref, sortableTable, handleSortClick, pager } from '../lib/capital-flows-ui';

  type Row = Record<string, any>;
  const $ = <T extends HTMLElement>(selector: string) => document.querySelector<T>(selector)!;
  const quarterSelect = $<HTMLSelectElement>('#quarter');
  const search = $<HTMLInputElement>('#search');
  const direction = $<HTMLSelectElement>('#direction');
  const minChange = $<HTMLInputElement>('#min-change');
  const minPct = $<HTMLInputElement>('#min-pct');
  const newSchemes = $<HTMLInputElement>('#new-schemes');
  const withDeals = $<HTMLInputElement>('#with-deals');
  const pageSize = 20;
  let rows: Row[] = [];
  let history: string[] = [];
  let page = 1;
  const sortState: { key: string; dir: 'asc' | 'desc' } = { key: 'change', dir: 'desc' };

  const quarterLabel = (period: string) => {
    const [y, m] = period.split('-');
    return `${['Mar', 'Jun', 'Sep', 'Dec'][Math.floor(Number(m) / 3) - 1]} ${y}`;
  };
  const pp = (v: number | null) => v == null ? '-' : `${v > 0 ? '+' : ''}${v.toFixed(2)}`;
  const signed = (v: number | null, digits = 1, suffix = '%') => v == null ? '-' : `<span class="${v > 0 ? 'pos' : v < 0 ? 'neg' : ''}">${v > 0 ? '+' : ''}${v.toFixed(digits)}${suffix}</span>`;
  const sparkline = (values: (number | null)[]) => {
    const points = values.map((v, i) => [i, v] as const).filter(([, v]) => v != null) as [number, number][];
    if (points.length < 2) return '';
    const max = Math.max(...points.map(([, v]) => v), 1);
    const w = 80, h = 22, step = w / Math.max(values.length - 1, 1);
    const path = points.map(([i, v], n) => `${n ? 'L' : 'M'}${(i * step).toFixed(1)},${(h - 2 - (v / max) * (h - 4)).toFixed(1)}`).join('');
    const title = values.map((v, i) => `${quarterLabel(history[i])}: ${v == null ? '-' : `${v}%`}`).join(', ');
    return `<svg class="spark" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" role="img" aria-label="${escapeHtml(title)}"><title>${escapeHtml(title)}</title><path d="${path}" fill="none" stroke="var(--leaf)" stroke-width="1.6"/></svg>`;
  };

  /** Only moves of at least 0.1 pp, so quiet holders don't clutter the row. */
  const others = (r: Row) => ([['FPI', r.fpiPctChange], ['Insurance', r.insurancePctChange], ['Promoter', r.promoterPctChange]] as [string, number | null][])
    .filter(([, v]) => v != null && Math.abs(v) >= 0.1)
    .map(([label, v]) => `${label} ${signed(v, 2, '')}`).join('<br>') || '-';

  /** "NIPPON LIFE INDIA TRUSTEE LTD-A/C NIPPON INDIA SMALL CAP FUND" -> "NIPPON INDIA SMALL CAP FUND". */
  const shortScheme = (name: string) => name.replace(/^.*\bA\/C\.?\s*/i, '').replace(/^.*TRUSTEE\s+(?:CO(?:MPANY)?\.?\s+)?(?:PVT\.?\s+)?(?:LTD|LIMITED)\.?\s*[-–]\s*/i, '').replace(/^.*?MUTUAL FUND\s*-\s*/i, '').trim() || name;

  const tip = (label: string, title: string) => `<span title="${title}">${label}</span>`;
  const columns: [string, string, boolean?][] = [
    ['symbol', 'Stock'],
    ['change', tip('MF holding', 'Share of the company held by all mutual funds; change in percentage points, and the change in shares they hold'), true],
    ['schemes', tip('Schemes', 'Mutual fund schemes holding the stock, and the change'), true],
    ['newSchemes', tip('New funds &gt;1%', 'Schemes now above 1% that were not last quarter (hover a cell for all)')],
    ['others', tip('Others (pp)', 'Same-quarter change for foreign portfolio investors, insurance and promoters')],
    ['deals', tip('Fund deals', 'Mutual funds\' bulk/block buys and sells in the quarter'), true],
    ['trend', tip('Trend', 'MF holding over up to 8 quarters')],
  ];
  const sortValue: Record<string, (r: Row) => unknown> = {
    symbol: (r) => r.symbol, change: (r) => r.change, schemes: (r) => r.schemesChange, newSchemes: (r) => r.newSchemes.length,
    others: (r) => r.fpiPctChange, deals: (r) => r.mfDealBuy - r.mfDealSell, trend: (r) => r.change,
  };

  function filtered() {
    const text = search.value.trim().toUpperCase();
    const min = Math.max(0, Number(minChange.value) || 0);
    const minHolding = Math.max(0, Number(minPct.value) || 0);
    return rows.filter((r) => {
      if (text && !r.symbol.includes(text) && !String(r.name).toUpperCase().includes(text)) return false;
      if ((r.mfPct ?? 0) < minHolding && (r.mfPctPrev ?? 0) < minHolding) return false;
      if (direction.value === 'up' && !((r.change ?? 0) >= Math.max(min, 0.01))) return false;
      if (direction.value === 'down' && !((r.change ?? 0) <= -Math.max(min, 0.01))) return false;
      if (direction.value === 'all' && Math.abs(r.change ?? 0) < min) return false;
      if (newSchemes.checked && !r.newSchemes.length) return false;
      if (withDeals.checked && !r.mfDealBuy) return false;
      return true;
    });
  }

  function render() {
    const { header, sort } = sortableTable<Row>(columns.map(([k, l, n]) => [k, l, n]), sortState, 'sort');
    const all = sort(filtered(), (r, key) => sortValue[key](r));
    const pages = Math.max(1, Math.ceil(all.length / pageSize));
    page = Math.min(page, pages);
    $('#count').textContent = `${all.length.toLocaleString('en-IN')} stocks`;
    const list = $('#list');
    if (!all.length) {
      list.innerHTML = '<p class="empty">No stocks match these filters. Try a smaller minimum change.</p>';
    } else {
      list.innerHTML = `<div class="deal-table-wrap"><table class="deal-table"><thead><tr>${header}</tr></thead><tbody>${all.slice((page - 1) * pageSize, page * pageSize).map((r) => {
        const shown = r.newSchemes.slice(0, 2).map((n: string) => escapeHtml(shortScheme(n))).join('<br>');
        const more = r.newSchemes.length > 2 ? `<br>+${r.newSchemes.length - 2} more` : '';
        const allSchemes = escapeHtml(r.newSchemes.map(shortScheme).join('\n'));
        const deals = r.mfDealBuy || r.mfDealSell
          ? `${r.mfDealBuy ? `<span class="pos">${crore(r.mfDealBuy)}</span>` : ''}${r.mfDealBuy && r.mfDealSell ? ' / ' : ''}${r.mfDealSell ? `<span class="neg">−${crore(r.mfDealSell)}</span>` : ''}`
          : '-';
        return `<tr>
          <td class="stock" data-label="Stock"><a class="entity-link" href="${stockHref(r.symbol)}"><strong>${escapeHtml(r.symbol)}</strong></a><span class="stock-name">${escapeHtml(r.name)}</span></td>
          <td class="number" data-label="MF holding"><strong>${(r.mfPct ?? 0).toFixed(2)}%</strong> <span class="${r.change > 0 ? 'pos' : r.change < 0 ? 'neg' : ''}">${pp(r.change)}</span><span class="stock-name">${r.mfPctPrev == null ? 'new' : `from ${r.mfPctPrev.toFixed(2)}%`}${r.sharesChange == null ? '' : ` · shares ${r.sharesChange > 0 ? '+' : ''}${r.sharesChange.toFixed(0)}%${r.splitAdjusted ? '*' : ''}`}</span></td>
          <td class="number" data-label="Schemes">${r.mfHolders ?? 0}${r.schemesChange ? ` <span class="${r.schemesChange > 0 ? 'pos' : 'neg'}">(${r.schemesChange > 0 ? '+' : ''}${r.schemesChange})</span>` : ''}</td>
          <td data-label="New funds >1%"><div class="scheme-list" title="${allSchemes}">${shown ? shown + more : '-'}</div></td>
          <td data-label="Others (pp)"><div class="scheme-list">${others(r)}</div></td>
          <td class="number" data-label="Fund deals">${deals}</td>
          <td data-label="Trend">${sparkline(r.history)}</td></tr>`;
      }).join('')}</tbody></table></div>`;
    }
    $('#pages').innerHTML = pager(all.length, page, pageSize, 'page');
  }

  async function loadQuarter(period: string) {
    $('#list').innerHTML = '<p class="loading">Loading…</p>';
    const data = await (await fetch(`/data/ownership/screen/${period}.json`)).json();
    history = data.history;
    rows = data.rows.map((values: unknown[]) => {
      const r: Row = Object.fromEntries(data.columns.map((c: string, i: number) => [c, values[i]]));
      r.change = r.mfPctPrev == null ? null : Math.round(((r.mfPct ?? 0) - r.mfPctPrev) * 100) / 100;
      r.schemesChange = r.mfHoldersPrev == null ? null : (r.mfHolders ?? 0) - r.mfHoldersPrev;
      // Splits, bonuses and consolidations change every holder's share count; scale the
      // previous count by the company's own change so only real buying or selling shows.
      const ratio = r.shares && r.sharesPrev ? r.shares / r.sharesPrev : 1;
      r.splitAdjusted = ratio > 1.4 || ratio < 0.7;
      const prevShares = r.mfSharesPrev && r.splitAdjusted ? r.mfSharesPrev * ratio : r.mfSharesPrev;
      r.sharesChange = prevShares ? Math.round((((r.mfShares ?? 0) - prevShares) / prevShares) * 1000) / 10 : null;
      return r;
    });
    $('#screen-heading').textContent = `Mutual fund accumulation · ${quarterLabel(data.period)} vs ${quarterLabel(data.previous)}`;
    page = 1;
    render();
  }

  fetch('/data/ownership/index.json').then((r) => r.json()).then(async (index) => {
    const counts = new Map<string, number>(index.quarters);
    quarterSelect.innerHTML = index.screens.map((p: string) => `<option value="${p}">${quarterLabel(p)}</option>`).join('');
    const update = () => {
      const p = quarterSelect.value;
      $('#screen-coverage').textContent = `${(counts.get(p) || 0).toLocaleString('en-IN')} companies have filed for ${quarterLabel(p)}`;
      loadQuarter(p);
    };
    quarterSelect.addEventListener('change', update);
    update();
  }).catch(() => { $('#list').innerHTML = '<p class="empty">Ownership data is temporarily unavailable.</p>'; });

  [search, direction, minChange, minPct, newSchemes, withDeals].forEach((el) => el.addEventListener('input', () => { page = 1; render(); }));
  // Biggest moves first in either direction.
  direction.addEventListener('input', () => { sortState.key = 'change'; sortState.dir = direction.value === 'down' ? 'asc' : 'desc'; render(); });
  $('#list').addEventListener('click', (event) => { if (handleSortClick(event, 'sort', sortState)) { page = 1; render(); } });
  $('#pages').addEventListener('click', (event) => {
    const next = Number((event.target as HTMLElement).dataset.page);
    if (next >= 1) { page = next; render(); }
  });
</script>
