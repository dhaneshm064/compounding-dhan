---
import Base from '../layouts/Base.astro';
---

<Base title="Ownership Radar · Compounding Dhan" description="Institutional and mutual-fund ownership changes.">
  <section class="ownership-page">
    <p class="back-link"><a href="/capital-flows">← Capital Flows</a></p>
    <h1>Ownership Radar</h1>
    <p class="intro">Quarterly institutional ownership and monthly mutual-fund portfolio changes across the tracked universe.</p>
    <div id="ownership-summary" class="summary loading">Loading ownership data…</div>
    <div id="ownership-list" class="empty">No ownership files have been imported yet.</div>
  </section>
</Base>

<style>
  .ownership-page { padding: 2rem 1.25rem 4rem; max-width: 72rem; margin: auto; }
  .back-link { margin-bottom: 1rem; }
  .intro { color: var(--muted); max-width: 44rem; line-height: 1.55; }
  .summary { margin: 1.5rem 0; padding: 1rem; border: 1px solid var(--line); border-radius: .7rem; background: var(--paper-2); }
  .empty { padding: 1.25rem; border: 1px dashed var(--line); border-radius: .7rem; color: var(--muted); }
</style>

<script>
  const summary = document.querySelector('#ownership-summary');
  const list = document.querySelector('#ownership-list');
  fetch('/data/ownership/ownership-summary.json').then(async (response) => {
    const data = await response.json();
    if (!response.ok) throw new Error('Unavailable');
    summary.textContent = `${Number(data.eventCount || 0).toLocaleString('en-IN')} ownership events across ${Number(data.stocks || 0).toLocaleString('en-IN')} stocks and ${Number(data.investors || 0).toLocaleString('en-IN')} investors.`;
    if (data.eventCount) list.textContent = 'Ownership event indexes are ready for stock and investor views.';
  }).catch(() => { summary.textContent = 'Ownership data is not available yet.'; });
</script>
